import FipsSoundness

open ZkBuild ZkBuild.WordArithmetic ZkBuild.ScalarMontgomery ZkBuild.FipsMontgomery

def fipsCases : Array (Nat × Nat) := Id.run do
  let edges := #[0, 1, 2, scalarModulus-1, scalarModulus-2, scalarR2, 2^127, 2^254]
  let mut cases := #[]
  for a in edges do
    for b in edges do cases := cases.push (a, b)
  for word in [:8] do
    for value in [0, 1, 0x7fffffff, 0x80000000, 0xfffffffe, 0xffffffff] do
      let a := value*base^word % scalarModulus
      cases := cases.push (a, scalarR2)
      cases := cases.push (scalarR2, a)
  let mut seed := 0x243f6a88
  for _ in [:352] do
    let mut values := #[]
    for _ in [:2] do
      let mut value := 0
      for _ in [:8] do
        seed := (seed*1664525+1013904223)%base
        value := value*base+seed
      values := values.push (value%scalarModulus)
    cases := cases.push (values[0]!, values[1]!)
  return cases

def fipsWords (words : Words) : List Nat := (List.range 8).map fun i => (get words i).toNat
def fipsRow (row : Row) : List Nat :=
  [row.stage, row.column] ++ fipsWords row.state.z ++
    [row.state.acc.hi.toNat, row.state.acc.mid.toNat, row.state.acc.lo.toNat]
def numbers (values : List Nat) : String := String.intercalate " " (values.map toString)
def nimNumbers (values : List Nat) : String :=
  "[" ++ String.intercalate ", " (values.map fun x => s!"{x}'u32") ++ "]"

def main (args : List String) : IO Unit := do
  let (nim, destination) ← match args with
    | [destination] => pure (false, destination)
    | ["--nim", destination] => pure (true, destination)
    | _ => throw (IO.userError "usage: export_fips_montgomery [--nim] OUTPUT")
  let output ← IO.FS.Handle.mk destination .write
  let cases := fipsCases
  if nim then
    output.putStrLn "# Generated by the Lean FIPS schedule. Do not edit."
    output.putStrLn "const FipsVectors = ["
  else output.putStrLn s!"ZKFIPS1 {cases.size} 17 13"
  for index in [:cases.size] do
    if !nim || index%32 = 0 then
      let (x, y) := cases[index]!
      let a := fromNat x
      let b := fromNat y
      let finalState := upperPrefix a b 8
      let expected := fromNat (x*y*scalarRadixInverse%scalarModulus)
      let observed := finish finalState
      if fipsWords observed != fipsWords expected then
        throw (IO.userError s!"FIPS model disagrees with modular arithmetic at case {index}")
      let trace := rows a b ++ [⟨2, 16, ⟨finalState.acc, observed⟩⟩]
      if nim then
        output.putStrLn s!"  FipsCase(a: {nimNumbers (fipsWords a)}, b: {nimNumbers (fipsWords b)}, expected: {nimNumbers (fipsWords expected)}, trace: ["
        for row in trace do output.putStrLn s!"    {nimNumbers (fipsRow row)},"
        output.putStrLn "  ]),"
      else
        output.putStrLn ("I " ++ numbers (fipsWords a ++ fipsWords b ++ fipsWords expected))
        for row in trace do output.putStrLn ("T " ++ numbers (fipsRow row))
  if nim then output.putStrLn "]"
