import CiosReference

open ZkBuild WordArithmetic ScalarMontgomery FipsMontgomery CiosMontgomery

def ciosCases : Array Nat := Id.run do
  let mut cases := #[0, 1, 2, scalarModulus-1, scalarModulus, scalarModulus+1,
    2*scalarModulus-1, scalarRadix-1]
  for word in [:8] do
    for value in [0, 1, 0x7fffffff, 0x80000000, 0xfffffffe, 0xffffffff] do
      cases := cases.push (value*base^word)
  let mut seed := 0x243f6a88
  for _ in [:456] do
    let mut value := 0
    for _ in [:8] do
      seed := (seed*1664525+1013904223)%base
      value := value*base+seed
    cases := cases.push value
  return cases

def ciosWords (words : Words) : List Nat := (List.range 8).map fun i => (get words i).toNat
def ciosRow (row : CiosMontgomery.Row) : List Nat :=
  [row.outer, row.column] ++ ciosWords row.words ++
    [row.multiplier.toNat, row.carry.toNat, row.low.toNat]
def numbers (values : List Nat) : String := String.intercalate " " (values.map toString)
def nimNumbers (values : List Nat) : String :=
  "[" ++ String.intercalate ", " (values.map fun x => s!"{x}'u32") ++ "]"

def main (args : List String) : IO Unit := do
  let (nim, destination) ← match args with
    | [destination] => pure (false, destination)
    | ["--nim", destination] => pure (true, destination)
    | _ => throw (IO.userError "usage: export_cios_montgomery [--nim] OUTPUT")
  let output ← IO.FS.Handle.mk destination .write
  let cases := ciosCases
  if nim then
    output.putStrLn "# Generated by the Lean CIOS schedule. Do not edit."
    output.putStrLn "const CiosVectors = ["
  else output.putStrLn s!"ZKCIOS1 {cases.size} 73 13"
  for index in [:cases.size] do
    if !nim || index < 8 || (index-8)%64 = 0 then
      let value := cases[index]!
      let input := fromNat value
      let expected := fromNat (value*scalarRadixInverse%scalarModulus)
      let observed := CiosReference.view (CiosReference.cachedResult input)
      if ciosWords observed != ciosWords expected then
        throw (IO.userError s!"CIOS model disagrees with modular arithmetic at case {index}")
      let trace := CiosReference.cachedRows input ++ [⟨8, 9, observed, 0, 0, 0⟩]
      if nim then
        output.putStrLn s!"  CiosCase(input: {nimNumbers (ciosWords input)}, expected: {nimNumbers (ciosWords expected)}, trace: ["
        for row in trace do output.putStrLn s!"    {nimNumbers (ciosRow row)},"
        output.putStrLn "  ]),"
      else
        output.putStrLn ("I " ++ numbers (ciosWords input ++ ciosWords expected))
        for row in trace do output.putStrLn ("T " ++ numbers (ciosRow row))
  if nim then output.putStrLn "]"
