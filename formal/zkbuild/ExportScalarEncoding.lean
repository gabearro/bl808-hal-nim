import ScalarMontgomery

open ZkBuild.ScalarEncoding
open ZkBuild.ScalarMontgomery

def vectors : Array (List (Fin 256)) := Id.run do
  let mut out := #[[], List.replicate 32 0, modulusBytes, List.replicate 32 255,
    List.replicate 31 0, List.replicate 33 0]
  for position in [:32] do
    for value in List.finRange 256 do
      for mode in [:3] do
        let mut bytes := modulusBytes.toArray
        bytes := bytes.set! position value
        if mode != 0 then
          for suffix in [position+1:32] do bytes := bytes.set! suffix (if mode = 1 then 0 else 255)
        out := out.push bytes.toList
  let mut seed := 0x243f6a88
  for _ in [:1024] do
    let mut bytes := []
    for _ in [:32] do
      seed := (seed*1664525+1013904223)%4294967296
      bytes := bytes ++ [⟨(seed/16777216)%256, Nat.mod_lt _ (by decide)⟩]
    out := out.push bytes
  for length in [:65] do
    if length != 32 then out := out.push (List.replicate length 0)
  return out

def hexadecimal (bytes : List (Fin 256)) : String :=
  if bytes.isEmpty then "-" else String.ofList (bytes.flatMap fun byte =>
    let digits := "0123456789abcdef".toList.toArray
    [digits[byte.val/16]!, digits[byte.val%16]!])

def exportEncodings (destination : String) : IO Unit := do
  let output ← IO.FS.Handle.mk destination .write
  let cases := vectors
  output.putStrLn s!"ZKSCALAR3 131072 {cases.size}"
  output.putStrLn s!"MODULUS {hexadecimal modulusBytes}"
  output.putStrLn s!"R2 {hexadecimal (encode scalarR2)}"
  output.putStrLn s!"ONE {hexadecimal (encode (scalarRadix % ZkBuild.scalarModulus))}"
  output.putStrLn s!"N32 {scalarNegativeInverse % 2^32}"
  output.putStrLn s!"N64 {scalarNegativeInverse % 2^64}"
  for a in List.finRange 256 do
    for b in List.finRange 256 do
      for incoming in List.finRange 2 do
        output.putStrLn s!"B {a.val} {b.val} {incoming.val} {borrowDigit a b incoming.val}"
  for bytes in cases do
    -- The oracle uses the integer specification, not the subtraction algorithm.
    let expected := decide (bytes.length = 32 ∧ valueBE bytes < ZkBuild.scalarModulus)
    output.putStrLn s!"V {bytes.length} {if expected then 1 else 0} {hexadecimal bytes}"
    if bytes.length = 32 then
      let input := fun index => (bytes[index]?).getD ⟨0, by decide⟩
      for width in [4, 8] do
        let packed := ZkBuild.ScalarWords.words width input
        output.putStrLn ((if width = 4 then "W32" else "W64") ++
          String.join (packed.map fun value => s!" {value.toNat}"))
      if expected then
        let value := valueBE bytes
        -- Direct modular arithmetic is independent of the reduction algorithm.
        output.putStrLn s!"M {hexadecimal (encode (value * scalarRadix % ZkBuild.scalarModulus))}"
        output.putStrLn s!"F {hexadecimal (encode (value * scalarRadixInverse % ZkBuild.scalarModulus))}"

def nimBytes (value : Nat) : String :=
  "[" ++ String.intercalate ", " ((encode value).map fun byte => s!"{byte.val}'u8") ++ "]"

def exportMontgomery (destination : String) : IO Unit := do
  let output ← IO.FS.Handle.mk destination .write
  output.putStrLn "# Generated by the Lean integer oracle. Do not edit."
  output.putStrLn s!"const ScalarR2Reference = {nimBytes scalarR2}"
  output.putStrLn s!"const ScalarOneReference = {nimBytes (scalarRadix % ZkBuild.scalarModulus)}"
  output.putStrLn s!"const ScalarNegInverse32 = {scalarNegativeInverse % 2^32}'u32"
  output.putStrLn "const ScalarMontgomeryVectors = ["
  let mut cases := [0, 1, 2, ZkBuild.scalarModulus-1, ZkBuild.scalarModulus-2]
  for index in [:32] do
    cases := cases ++ [(ZkBuild.scalarModulus-1)/256^index, 2^(8*index)]
  let mut seed := 0x243f6a88
  for _ in [:32] do
    let mut value := 0
    for _ in [:8] do
      seed := (seed*1664525+1013904223)%4294967296
      value := value*4294967296+seed
    cases := cases ++ [value % ZkBuild.scalarModulus]
  for value in cases do
    output.putStrLn s!"  ({nimBytes value}, {nimBytes (value*scalarRadix % ZkBuild.scalarModulus)}, {nimBytes (value*scalarRadixInverse % ZkBuild.scalarModulus)}),"
  output.putStrLn "]"

def main (args : List String) : IO Unit := do
  match args with
  | [destination] => exportEncodings destination
  | ["--montgomery", destination] => exportMontgomery destination
  | _ => throw (IO.userError "usage: export_scalar_encoding [--montgomery] OUTPUT")
