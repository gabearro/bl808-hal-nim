import WordArithmetic

open ZkBuild.WordArithmetic

def boundaryWords : Array Nat := Id.run do
  let mut values := #[0, 1, 2, 0x7fffffff, 0x80000000, 0xfffffffe, 0xffffffff]
  for bit in [:32] do
    let power := 2^bit
    values := values ++ #[power-1, power, (power+1)%base]
  return values

def arithmeticRow (i j carry : Nat) : Array Nat := Id.run do
  let values := boundaryWords
  let a := values[i]!
  let b := values[j]!
  let c := values[(i+j)%values.size]!
  let d := values[(2*i+3*j)%values.size]!
  let t := values[(7*i+11*j)%values.size]!
  let u := values[(13*i+17*j)%values.size]!
  let v := values[(19*i+23*j)%values.size]!
  let addition := a+b+carry
  let borrow := if a < b+carry then 1 else 0
  let difference := a+base*borrow-b-carry
  let product := a*b
  let accumulate := (v+base*u+base^2*t+product) % base^3
  let column := v+base*u+16*product
  return #[a, b, c, d, carry, t, u, v,
    addition%base, addition/base, difference, borrow,
    product%base, product/base, (product+c)%base, (product+c)/base,
    (product+c+d)%base, (product+c+d)/base,
    accumulate%base, accumulate/base%base, accumulate/base^2,
    column%base, column/base%base, column/base^2]

def main (args : List String) : IO Unit := do
  let (nim, destination) ← match args with
    | [destination] => pure (false, destination)
    | ["--nim", destination] => pure (true, destination)
    | _ => throw (IO.userError "usage: export_word_arithmetic [--nim] OUTPUT")
  let output ← IO.FS.Handle.mk destination .write
  let size := boundaryWords.size
  if nim then
    output.putStrLn "# Generated by the Lean integer oracle. Do not edit."
    output.putStrLn "const WordArithmeticVectors = ["
  else output.putStrLn s!"ZKWORD1 {size*size*2} 24"
  for i in [:size] do
    for j in [:size] do
      for carry in [:2] do
        let index := (i*size+j)*2+carry
        if !nim || index % 43 = 0 then
          let row := arithmeticRow i j carry
          if nim then
            output.putStrLn ("  [" ++ String.intercalate ", " (row.toList.map fun x => s!"{x}'u32") ++ "],")
          else
            output.putStrLn (String.intercalate " " (row.toList.map toString))
  if nim then output.putStrLn "]"
