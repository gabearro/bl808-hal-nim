(component
  (type $token (resource (rep i32)))
  (canon resource.new $token (core func $new))
  (canon resource.rep $token (core func $rep))
  (canon resource.drop $token (core func $drop))
  (component $peer
    (import "token" (type $token (sub resource)))
    (export $public "token" (type $token))
    (canon resource.drop $token (core func $drop))
    (core module $m
      (import "" "drop" (func $drop (param i32)))
      (memory (export "mem") 1)
      (func (export "alloc") (param i32 i32 i32 i32) (result i32) (i32.const 16))
      (func (export "move") (param i32 i32) (result i32)
        (i32.store (i32.const 0) (local.get 0))
        (i32.store (i32.const 4) (local.get 1))
        (i32.const 0))
      (func (export "inspect") (param $present i32) (param $loan i32) (result i32)
        (if (result i32) (local.get $present)
          (then (call $drop (local.get $loan)) (local.get $loan))
          (else (i32.const 0)))))
    (core instance $i (instantiate $m
      (with "" (instance (export "drop" (func $drop))))))
    (func (export "move") (param "tokens" (list (own $public))) (result (list (own $public)))
      (canon lift (core func $i "move")
        (memory (core memory $i "mem")) (realloc (core func $i "alloc"))))
    (func (export "inspect") (param "token" (option (borrow $public))) (result u32)
      (canon lift (core func $i "inspect"))))
  (instance $peer (instantiate $peer (with "token" (type $token))))
  (core module $memory
    (memory (export "mem") 1)
    (func (export "alloc") (param i32 i32 i32 i32) (result i32) (i32.const 32)))
  (core instance $m (instantiate $memory))
  (canon lower (func $peer "move")
    (memory (core memory $m "mem")) (realloc (core func $m "alloc"))
    (core func $move))
  (canon lower (func $peer "inspect") (core func $inspect))
  (core module $caller
    (import "" "mem" (memory 1))
    (import "" "new" (func $new (param i32) (result i32)))
    (import "" "rep" (func $rep (param i32) (result i32)))
    (import "" "drop" (func $drop (param i32)))
    (import "" "move" (func $move (param i32 i32 i32)))
    (import "" "inspect" (func $inspect (param i32 i32) (result i32)))
    (func (export "run") (result i32)
      (local $returned i32) (local $one i32) (local $two i32)
      (i32.store (i32.const 16) (call $new (i32.const 19)))
      (i32.store (i32.const 20) (call $new (i32.const 22)))
      (call $move (i32.const 16) (i32.const 2) (i32.const 0))
      (if (i32.ne (i32.load (i32.const 4)) (i32.const 2)) (then unreachable))
      (local.set $returned (i32.load (i32.const 0)))
      (local.set $one (i32.load (local.get $returned)))
      (local.set $two (i32.load offset=4 (local.get $returned)))
      (if (i32.ne (call $rep (local.get $one)) (i32.const 19)) (then unreachable))
      (if (i32.ne (call $rep (local.get $two)) (i32.const 22)) (then unreachable))
      (if (i32.ne (call $inspect (i32.const 1) (local.get $one)) (i32.const 2))
        (then unreachable))
      (call $drop (local.get $one))
      (call $drop (local.get $two))
      (i32.const 42))
    (func (export "duplicate") (local $handle i32)
      (local.set $handle (call $new (i32.const 19)))
      (i32.store (i32.const 16) (local.get $handle))
      (i32.store (i32.const 20) (local.get $handle))
      (call $move (i32.const 16) (i32.const 2) (i32.const 0))))
  (core instance $main (instantiate $caller (with "" (instance
    (export "mem" (memory $m "mem"))
    (export "new" (func $new)) (export "rep" (func $rep)) (export "drop" (func $drop))
    (export "move" (func $move)) (export "inspect" (func $inspect))))))
  (func (export "run") (result u32) (canon lift (core func $main "run")))
  (func (export "duplicate") (canon lift (core func $main "duplicate"))))
