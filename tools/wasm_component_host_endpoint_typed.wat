(component
  (core module $storage
    (memory (export "mem") 1)
    (data (i32.const 128) "A\c3\a9B")
    (global $destroyed (mut i32) (i32.const 0))
    (global $bad-realloc (mut i32) (i32.const 0))
    (func (export "dispose") (param i32)
      (global.set $destroyed (i32.add (global.get $destroyed) (local.get 0))))
    (func (export "sum") (result i32) (global.get $destroyed))
    (func (export "arm-trap") (global.set $bad-realloc (i32.const 1)))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (if (global.get $bad-realloc) (then unreachable))
      (i32.const 256)))
  (core instance $storage (instantiate $storage))
  (alias core export $storage "mem" (core memory $mem))
  (alias core export $storage "realloc" (core func $realloc))
  (type $ticket (resource (rep i32) (dtor (core func $storage "dispose"))))
  (export $named "ticket" (type $ticket))
  (type $resource-future (future (own $named)))
  (type $string-future (future string))
  (type $nested-future (future $string-future))
  (type $transfer-future (future (tuple $string-future string)))
  (type $number-future (future u32))
  (type $units (stream))
  (core func $resource-new (canon resource.new $ticket))
  (core func $resource-drop (canon resource.drop $ticket))
  (core func $read-resource (canon future.read $resource-future async (memory $mem)))
  (core func $string-new (canon future.new $string-future))
  (core func $write-string (canon future.write $string-future async (memory $mem)))
  (core func $read-string (canon future.read $string-future async string-encoding=utf16
    (memory $mem) (realloc $realloc)))
  (core func $read-transfer (canon future.read $transfer-future async
    (memory $mem) (realloc $realloc)))
  (core func $read-units (canon stream.read $units async))
  (core func $read-number (canon future.read $number-future (memory $mem)))
  (core func $return (canon task.return (result u32)))
  (core func $waitable (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $poll (canon waitable-set.poll (memory $mem)))
  (core module $m
    (import "" "mem" (memory 1))
    (import "" "rr" (func $read-resource (param i32 i32) (result i32)))
    (import "" "rd" (func $resource-drop (param i32)))
    (import "" "sn" (func $string-new (result i64)))
    (import "" "sw" (func $write-string (param i32 i32) (result i32)))
    (import "" "sr" (func $read-string (param i32 i32) (result i32)))
    (import "" "tr" (func $read-transfer (param i32 i32) (result i32)))
    (import "" "ur" (func $read-units (param i32 i32 i32) (result i32)))
    (import "" "nr" (func $read-number (param i32 i32) (result i32)))
    (import "" "return" (func $return (param i32)))
    (import "" "new" (func $new-set (result i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "poll" (func $poll (param i32 i32) (result i32)))
    (global $set (mut i32) (i32.const 0))
    (global $string-writer (mut i32) (i32.const 0))
    (func (export "consume") (param i32)
      (if (call $read-resource (local.get 0) (i32.const 8)) (then unreachable))
      (call $resource-drop (i32.load (i32.const 8))))
    (func (export "make-string") (result i32)
      (local $pair i64)
      (local.set $pair (call $string-new))
      (global.set $string-writer (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32))))
      (i32.wrap_i64 (local.get $pair)))
    (func (export "produce-string") (result i32)
      (i32.store (i32.const 0) (i32.const 128))
      (i32.store (i32.const 4) (i32.const 4))
      (call $write-string (global.get $string-writer) (i32.const 0)))
    (func (export "consume-string") (param i32) (result i32)
      (if (call $read-string (local.get 0) (i32.const 8)) (then unreachable))
      (if (i32.ne (i32.load (i32.const 8)) (i32.const 256)) (then unreachable))
      (if (i32.ne (i32.load (i32.const 12)) (i32.const 3)) (then unreachable))
      (i32.load16_u (i32.const 258)))
    (func (export "park-transfer") (param i32)
      (if (i32.ne (call $read-transfer (local.get 0) (i32.const 8)) (i32.const -1))
        (then unreachable)))
    (func (export "wait-number") (param i32)
      (if (call $read-number (local.get 0) (i32.const 24)) (then unreachable))
      (call $return (i32.load (i32.const 24))))
    (func (export "nested-type") (param i32))
    (func (export "park") (param $reader i32)
      (global.set $set (call $new-set))
      (call $join (local.get $reader) (global.get $set))
      (if (i32.ne (call $read-units (local.get $reader) (i32.const -1) (i32.const 2))
                  (i32.const -1)) (then unreachable)))
    (func (export "poll") (result i32)
      (if (result i32) (i32.eq (call $poll (global.get $set) (i32.const 16)) (i32.const 2))
        (then (i32.load (i32.const 20))) (else (i32.const -1)))))
  (core instance $m (instantiate $m (with "" (instance
    (export "mem" (memory $mem)) (export "rr" (func $read-resource))
    (export "rd" (func $resource-drop)) (export "sn" (func $string-new))
    (export "sw" (func $write-string)) (export "sr" (func $read-string)) (export "tr" (func $read-transfer))
    (export "ur" (func $read-units)) (export "new" (func $waitable))
    (export "nr" (func $read-number)) (export "return" (func $return))
    (export "join" (func $join)) (export "poll" (func $poll))))))
  (func (export "new") (param "value" u32) (result (own $named)) (canon lift (core func $resource-new)))
  (func (export "sum") (result u32) (canon lift (core func $storage "sum")))
  (func (export "consume") (param "ticket" $resource-future) (canon lift (core func $m "consume")))
  (func (export "make-string") (result $string-future) (canon lift (core func $m "make-string")))
  (func (export "produce-string") (result s32) (canon lift (core func $m "produce-string")))
  (func (export "consume-string") (param "value" $string-future) (result u32)
    (canon lift (core func $m "consume-string")))
  (func (export "park-transfer") (param "value" $transfer-future)
    (canon lift (core func $m "park-transfer")))
  (func (export "wait-number") async (param "value" $number-future) (result u32)
    (canon lift (core func $m "wait-number") async))
  (func (export "nested-type") (param "value" $nested-future)
    (canon lift (core func $m "nested-type")))
  (func (export "arm-trap") (canon lift (core func $storage "arm-trap")))
  (func (export "park") (param "value" $units) (canon lift (core func $m "park")))
  (func (export "poll") (result s32) (canon lift (core func $m "poll"))))
