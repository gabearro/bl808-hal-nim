(component
  (type $unit (future))
  (core func $new (canon future.new $unit))
  (core func $read (canon future.read $unit))
  (core func $write (canon future.write $unit async))
  (core func $yield (canon thread.yield))
  (core func $filled (canon task.return))
  (core func $return (canon task.return (result u32)))
  (core module $producer
    (import "" "w" (func $write (param i32 i32) (result i32)))
    (import "" "y" (func $yield (result i32)))
    (import "" "done" (func $filled))
    (func (export "fill") (param $writer i32)
      (if (call $yield) (then unreachable))
      (if (call $write (local.get $writer) (i32.const -1)) (then unreachable))
      (call $filled)))
  (core instance $producer (instantiate $producer (with "" (instance
    (export "w" (func $write)) (export "y" (func $yield)) (export "done" (func $filled))))))
  (func $fill async (param "writer" u32) (canon lift (core func $producer "fill") async))
  (core func $enqueue (canon lower (func $fill) async))
  (core module $consumer
    (import "" "n" (func $new (result i64)))
    (import "" "e" (func $enqueue (param i32) (result i32)))
    (import "" "r" (func $read (param i32 i32) (result i32)))
    (import "" "done" (func $return (param i32)))
    (func (export "run")
      (local $pair i64)
      (local.set $pair (call $new))
      (drop (call $enqueue (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32)))))
      (if (call $read (i32.wrap_i64 (local.get $pair)) (i32.const -1)) (then unreachable))
      (call $return (i32.const 42))))
  (core instance $consumer (instantiate $consumer (with "" (instance
    (export "n" (func $new)) (export "e" (func $enqueue))
    (export "r" (func $read)) (export "done" (func $return))))))
  (func (export "run") async (result u32) (canon lift (core func $consumer "run") async)))
