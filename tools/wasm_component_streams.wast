(component definition $limits
  (type $unit (stream))
  (core func $new (canon stream.new $unit))
  (core func $read (canon stream.read $unit async))
  (core func $write (canon stream.write $unit async))
  (core func $cancel (canon stream.cancel-read $unit))
  (core module $m
    (import "" "n" (func $new (result i64)))
    (import "" "r" (func $read (param i32 i32 i32) (result i32)))
    (import "" "w" (func $write (param i32 i32 i32) (result i32)))
    (import "" "c" (func $cancel (param i32) (result i32)))
    (func (export "max-units") (result i32)
      (local $pair i64) (local $reader i32) (local $writer i32)
      (local.set $pair (call $new))
      (local.set $reader (i32.wrap_i64 (local.get $pair)))
      (local.set $writer (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32))))
      (if (i32.ne (call $read (local.get $reader) (i32.const -1) (i32.const 0x0fffffff))
                  (i32.const -1)) (then unreachable))
      (if (i32.ne (call $write (local.get $writer) (i32.const -1) (i32.const 0x0fffffff))
                  (i32.const 0xfffffff0)) (then unreachable))
      (if (i32.ne (call $cancel (local.get $reader)) (i32.const 0xfffffff2))
        (then unreachable))
      (i32.const 42))
    (func (export "oversize")
      (drop (call $read (i32.wrap_i64 (call $new)) (i32.const 0) (i32.const 0x10000000)))))
  (core instance $m (instantiate $m (with "" (instance
    (export "n" (func $new)) (export "r" (func $read))
    (export "w" (func $write)) (export "c" (func $cancel))))))
  (func (export "max-units") (result u32) (canon lift (core func $m "max-units")))
  (func (export "oversize") (canon lift (core func $m "oversize"))))
(component instance $ok $limits)
(assert_return (invoke "max-units") (u32.const 42))
(component instance $overflow $limits)
(assert_trap (invoke "oversize") "canonical stream buffer length out of range")
