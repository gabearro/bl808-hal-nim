(component definition $local
  (type $unit (future))
  (core func $new (canon future.new $unit))
  (core func $read (canon future.read $unit))
  (core func $read-async (canon future.read $unit async))
  (core func $write (canon future.write $unit async))
  (core func $cancel (canon future.cancel-read $unit))
  (core func $forward (canon future.forward $unit))
  (core func $drop-r (canon future.drop-readable $unit))
  (core func $drop-w (canon future.drop-writable $unit))
  (core module $m
    (import "" "n" (func $new (result i64)))
    (import "" "r" (func $read (param i32 i32) (result i32)))
    (import "" "a" (func $read-async (param i32 i32) (result i32)))
    (import "" "w" (func $write (param i32 i32) (result i32)))
    (import "" "c" (func $cancel (param i32) (result i32)))
    (import "" "f" (func $forward (param i32 i32)))
    (import "" "dr" (func $drop-r (param i32)))
    (import "" "dw" (func $drop-w (param i32)))
    (func $reader (param i64) (result i32) (i32.wrap_i64 (local.get 0)))
    (func $writer (param i64) (result i32)
      (i32.wrap_i64 (i64.shr_u (local.get 0) (i64.const 32))))
    (func (export "run") (result i32)
      (local $a i64) (local $b i64)
      ;; Forward two live copies and consume the reader's completion by cancelling.
      (local.set $a (call $new))
      (local.set $b (call $new))
      (if (i32.ne (call $write (call $writer (local.get $a)) (i32.const -1)) (i32.const -1))
        (then unreachable))
      (if (i32.ne (call $read-async (call $reader (local.get $b)) (i32.const -1)) (i32.const -1))
        (then unreachable))
      (call $forward (call $reader (local.get $a)) (call $writer (local.get $b)))
      (if (call $cancel (call $reader (local.get $b))) (then unreachable))
      (call $drop-r (call $reader (local.get $b)))
      ;; A writer can be dropped after observing that its reader went away.
      (local.set $b (call $new))
      (call $drop-r (call $reader (local.get $b)))
      (if (i32.ne (call $write (call $writer (local.get $b)) (i32.const -1)) (i32.const 1))
        (then unreachable))
      (call $drop-w (call $writer (local.get $b)))
      ;; Forwarding a loop consumes both handles without trapping.
      (local.set $b (call $new))
      (call $forward (call $reader (local.get $b)) (call $writer (local.get $b)))
      ;; A synchronous reader consumes a waiting unit write inline.
      (local.set $b (call $new))
      (if (i32.ne (call $write (call $writer (local.get $b)) (i32.const -1)) (i32.const -1))
        (then unreachable))
      (if (call $read (call $reader (local.get $b)) (i32.const -1)) (then unreachable))
      (i32.const 42))
    (func (export "wrong-end")
      (drop (call $read (call $writer (call $new)) (i32.const 0)))))
  (core instance $i (instantiate $m (with "" (instance
    (export "n" (func $new)) (export "r" (func $read)) (export "a" (func $read-async))
    (export "w" (func $write)) (export "c" (func $cancel)) (export "f" (func $forward))
    (export "dr" (func $drop-r)) (export "dw" (func $drop-w))))))
  (func (export "run") (result u32) (canon lift (core func $i "run")))
  (func (export "wrong-end") (canon lift (core func $i "wrong-end"))))
(component instance $local-instance $local)
(assert_return (invoke "run") (u32.const 42))
(assert_trap (invoke "wrong-end") "canonical future endpoint type mismatch")

(component definition $typed
  (core module $mem (memory (export "mem") 1))
  (core instance $mem (instantiate $mem))
  (alias core export $mem "mem" (core memory $memory))
  (type $number (future u16))
  (type $bool (future bool))
  (core func $new (canon future.new $number))
  (core func $new-bool (canon future.new $bool))
  (core func $read (canon future.read $number async (memory $memory)))
  (core func $read-bool (canon future.read $bool async (memory $memory)))
  (core func $write-bool (canon future.write $bool async (memory $memory)))
  (core module $m
    (import "" "n" (func $new (result i64)))
    (import "" "b" (func $new-bool (result i64)))
    (import "" "r" (func $read (param i32 i32) (result i32)))
    (import "" "rb" (func $read-bool (param i32 i32) (result i32)))
    (import "" "wb" (func $write-bool (param i32 i32) (result i32)))
    (func (export "unaligned")
      (drop (call $read (i32.wrap_i64 (call $new)) (i32.const 1))))
    (func (export "out-of-bounds")
      (drop (call $read (i32.wrap_i64 (call $new)) (i32.const 65536))))
    (func (export "wrong-type")
      (drop (call $read (i32.wrap_i64 (call $new-bool)) (i32.const 0))))
    (func (export "non-numeric")
      (local $pair i64)
      (local.set $pair (call $new-bool))
      (drop (call $read-bool (i32.wrap_i64 (local.get $pair)) (i32.const 0)))
      (drop (call $write-bool (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32))) (i32.const 1)))))
  (core instance $i (instantiate $m (with "" (instance
    (export "n" (func $new)) (export "b" (func $new-bool)) (export "r" (func $read))
    (export "rb" (func $read-bool)) (export "wb" (func $write-bool))))))
  (func (export "unaligned") (canon lift (core func $i "unaligned")))
  (func (export "out-of-bounds") (canon lift (core func $i "out-of-bounds")))
  (func (export "wrong-type") (canon lift (core func $i "wrong-type")))
  (func (export "non-numeric") (canon lift (core func $i "non-numeric"))))
(component instance $alignment $typed)
(assert_trap (invoke "unaligned") "unaligned canonical future buffer")
(component instance $bounds $typed)
(assert_trap (invoke "out-of-bounds") "out of bounds")
(component instance $type-check $typed)
(assert_trap (invoke "wrong-type") "canonical future endpoint type mismatch")
(component instance $non-numeric $typed)
(assert_trap (invoke "non-numeric") "a local future rendezvous requires a unit or numeric payload")

(assert_invalid
  (component (type $not-future (list u8)) (core func (canon future.new $not-future)))
  "canonical future operation requires a future type")
(assert_invalid
  (component (type $typed (future u8)) (core func (canon future.read $typed async)))
  "typed future copy requires canonical memory")

(component definition $transfer
  (component $producer
    (type $future (future string))
    (core module $storage
      (memory (export "mem") 1)
      (data (i32.const 0) "\10\00\00\00\05\00\00\00")
      (data (i32.const 16) "caf\c3\a9"))
    (core instance $storage (instantiate $storage))
    (core func $new (canon future.new $future))
    (core func $write (canon future.write $future async (memory (core memory $storage "mem"))))
    (core func $cancel (canon future.cancel-write $future))
    (core func $drop (canon future.drop-writable $future))
    (core module $writer
      (import "" "n" (func $new (result i64)))
      (import "" "w" (func $write (param i32 i32) (result i32)))
      (import "" "c" (func $cancel (param i32) (result i32)))
      (import "" "d" (func $drop (param i32)))
      (global $writer (mut i32) (i32.const 0))
      (func (export "make") (result i32)
        (local $pair i64)
        (local.set $pair (call $new))
        (global.set $writer (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32))))
        (i32.wrap_i64 (local.get $pair)))
      (func (export "send") (result i32)
        (call $write (global.get $writer) (i32.const 0)))
      (func (export "finish") (param $pending i32)
        (if (local.get $pending)
          (then (if (call $cancel (global.get $writer)) (then unreachable))))
        (call $drop (global.get $writer))))
    (core instance $writer (instantiate $writer (with "" (instance
      (export "n" (func $new)) (export "w" (func $write))
      (export "c" (func $cancel)) (export "d" (func $drop))))))
    (func (export "make") (result $future) (canon lift (core func $writer "make")))
    (func (export "send") (result s32) (canon lift (core func $writer "send")))
    (func (export "finish") (param "pending" u32) (canon lift (core func $writer "finish"))))
  (instance $source (instantiate $producer))
  (type $future (future string))
  (core module $storage
    (memory (export "mem") 1)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (i32.const 128)))
  (core instance $storage (instantiate $storage))
  (core func $make (canon lower (func $source "make")))
  (core func $send (canon lower (func $source "send")))
  (core func $finish (canon lower (func $source "finish")))
  (core func $read (canon future.read $future async string-encoding=utf16
    (memory (core memory $storage "mem")) (realloc (core func $storage "realloc"))))
  (core func $cancel (canon future.cancel-read $future))
  (core func $drop (canon future.drop-readable $future))
  (core module $reader
    (import "" "memory" (memory 1))
    (import "" "make" (func $make (result i32)))
    (import "" "send" (func $send (result i32)))
    (import "" "finish" (func $finish (param i32)))
    (import "" "read" (func $read (param i32 i32) (result i32)))
    (import "" "cancel" (func $cancel (param i32) (result i32)))
    (import "" "drop" (func $drop (param i32)))
    (func (export "check") (param $reader-first i32) (result i32)
      (local $reader i32)
      (local.set $reader (call $make))
      (if (local.get $reader-first)
        (then
          (if (i32.ne (call $read (local.get $reader) (i32.const 0)) (i32.const -1))
            (then unreachable))
          (if (call $send) (then unreachable))
          (if (call $cancel (local.get $reader)) (then unreachable)))
        (else
          (if (i32.ne (call $send) (i32.const -1)) (then unreachable))
          (if (call $read (local.get $reader) (i32.const 0)) (then unreachable))))
      (call $finish (i32.eqz (local.get $reader-first)))
      (call $drop (local.get $reader))
      (if (i32.ne (i32.load (i32.const 0)) (i32.const 128)) (then unreachable))
      (if (i32.ne (i32.load (i32.const 4)) (i32.const 4)) (then unreachable))
      (if (i64.ne (i64.load (i32.const 128)) (i64.const 0x00e9006600610063)) (then unreachable))
      (i32.const 42)))
  (core instance $reader (instantiate $reader (with "" (instance
    (export "memory" (memory $storage "mem"))
    (export "make" (func $make)) (export "send" (func $send)) (export "finish" (func $finish))
    (export "read" (func $read)) (export "cancel" (func $cancel)) (export "drop" (func $drop))))))
  (func (export "check") (param "reader-first" u32) (result u32)
    (canon lift (core func $reader "check"))))
(component instance $transfer-instance $transfer)
(assert_return (invoke "check" (u32.const 0)) (u32.const 42))
(assert_return (invoke "check" (u32.const 1)) (u32.const 42))

(component
  (component $source
    (core module $memory
      (memory (export "mem") 1)
      (global $destroyed (mut i32) (i32.const 0))
      (func (export "dispose") (param i32)
        (if (global.get $destroyed) (then unreachable))
        (global.set $destroyed (local.get 0)))
      (func (export "destroyed") (result i32) (global.get $destroyed)))
    (core instance $memory (instantiate $memory))
    (type $ticket (resource (rep i32) (dtor (core func $memory "dispose"))))
    (export $named "ticket" (type $ticket))
    (type $future (future (own $named)))
    (core func $owned (canon resource.new $ticket))
    (core func $create (canon future.new $future))
    (core func $write (canon future.write $future async (memory (core memory $memory "mem"))))
    (core module $m
      (import "" "memory" (memory 1))
      (import "" "o" (func $owned (param i32) (result i32)))
      (import "" "c" (func $create (result i64)))
      (import "" "w" (func $write (param i32 i32) (result i32)))
      (func (export "make") (result i32)
        (local $pair i64)
        (i32.store (i32.const 0) (call $owned (i32.const 42)))
        (local.set $pair (call $create))
        (if (i32.ne (call $write
                      (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32)))
                      (i32.const 0))
                    (i32.const -1)) (then unreachable))
        (i32.wrap_i64 (local.get $pair))))
    (core instance $i (instantiate $m (with "" (instance
      (export "memory" (memory $memory "mem")) (export "o" (func $owned))
      (export "c" (func $create)) (export "w" (func $write))))))
    (func (export "make") (result $future) (canon lift (core func $i "make")))
    (func (export "destroyed") (result u32) (canon lift (core func $memory "destroyed"))))
  (instance $source (instantiate $source))
  (alias export $source "ticket" (type $ticket))
  (type $future (future (own $ticket)))
  (core module $memory (memory (export "mem") 1))
  (core instance $memory (instantiate $memory))
  (core func $make (canon lower (func $source "make")))
  (core func $destroyed (canon lower (func $source "destroyed")))
  (core func $read (canon future.read $future async (memory (core memory $memory "mem"))))
  (core func $drop (canon resource.drop $ticket))
  (core module $m
    (import "" "memory" (memory 1))
    (import "" "m" (func $make (result i32)))
    (import "" "d" (func $destroyed (result i32)))
    (import "" "r" (func $read (param i32 i32) (result i32)))
    (import "" "x" (func $drop (param i32)))
    (func (export "own-through-future") (result i32)
      (if (call $read (call $make) (i32.const 0)) (then unreachable))
      (if (call $destroyed) (then unreachable))
      (call $drop (i32.load (i32.const 0)))
      (call $destroyed)))
  (core instance $i (instantiate $m (with "" (instance
    (export "memory" (memory $memory "mem"))
    (export "m" (func $make)) (export "d" (func $destroyed))
    (export "r" (func $read)) (export "x" (func $drop))))))
  (func (export "own-through-future") (result u32) (canon lift (core func $i "own-through-future"))))
(assert_return (invoke "own-through-future") (u32.const 42))

(component definition $ownership
  (type $unit (future))
  (core func $new (canon future.new $unit))
  (core func $read (canon future.read $unit async))
  (core func $write (canon future.write $unit async))
  (core func $cancel (canon future.cancel-read $unit))
  (core func $new-set (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core module $m
    (import "" "n" (func $new (result i64)))
    (import "" "r" (func $read (param i32 i32) (result i32)))
    (import "" "w" (func $write (param i32 i32) (result i32)))
    (import "" "c" (func $cancel (param i32) (result i32)))
    (import "" "s" (func $new-set (result i32)))
    (import "" "j" (func $join (param i32 i32)))
    (func (export "transfer") (param $state i32) (result i32)
      (local $pair i64) (local $reader i32)
      (local.set $pair (call $new))
      (local.set $reader (i32.wrap_i64 (local.get $pair)))
      (if (i32.eq (local.get $state) (i32.const 1))
        (then (call $join (local.get $reader) (call $new-set)))
        (else
          (if (i32.ne (call $read (local.get $reader) (i32.const -1)) (i32.const -1))
            (then unreachable))
          (if (local.get $state)
            (then
              (if (call $write (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32)))
                              (i32.const -1)) (then unreachable))
              (if (call $cancel (local.get $reader)) (then unreachable))))))
      (local.get $reader)))
  (core instance $m (instantiate $m (with "" (instance
    (export "n" (func $new)) (export "r" (func $read)) (export "w" (func $write))
    (export "c" (func $cancel)) (export "s" (func $new-set)) (export "j" (func $join))))))
  (func (export "transfer") (param "state" u32) (result $unit)
    (canon lift (core func $m "transfer"))))
(component instance $copying $ownership)
(assert_trap (invoke "transfer" (u32.const 0)) "canonical future transfer requires an idle, unjoined reader")
(component instance $joined $ownership)
(assert_trap (invoke "transfer" (u32.const 1)) "canonical future transfer requires an idle, unjoined reader")
(component instance $done $ownership)
(assert_trap (invoke "transfer" (u32.const 2)) "canonical future transfer requires an idle, unjoined reader")
