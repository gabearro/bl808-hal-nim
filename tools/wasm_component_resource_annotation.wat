(component $outer
  (type $ticket (resource (rep i32)))
  (type $other (resource (rep i32)))
  (canon resource.new $ticket (core func $new))
  (core module $m
    (import "" "new" (func $new (param i32) (result i32)))
    (func (export "make") (param i32) (result i32) (call $new (local.get 0)))
    (func (export "read") (param i32) (result i32) (local.get 0))
    (func (export "hidden") (result i32) (i32.const 99)))
  (core instance $c (instantiate $m (with "" (instance (export "new" (func $new))))))
  (func $make (param "id" u32) (result (own $ticket))
    (canon lift (core func $c "make")))
  (func $read (param "self" (borrow $ticket)) (result u32)
    (canon lift (core func $c "read")))
  (func $read-other (param "self" (borrow $other)) (result u32)
    (canon lift (core func $c "read")))
  (func $hidden (result u32) (canon lift (core func $c "hidden")))
  (type $bundle (list (own $ticket)))
  (type $other-bundle (list (own $other)))
  (type $contract (instance
    (alias outer $outer $ticket (type $source))
    (export "ticket" (type $R (eq $source)))
    (export "ticket-alias" (type (eq $R)))
    (type $bundle (list (own $R)))
    (export "bundle" (type (eq $bundle)))
    (export "make" (func (param "id" u32) (result (own $R))))
    (export "get" (func (param "self" (borrow $R)) (result u32)))))
  (instance $api
    (export "ticket" (type $ticket))
    (export "ticket-alias" (type $ticket))
    (export "bundle" (type $bundle))
    (export "make" (func $make))
    (export "get" (func $read))
    (export "hidden" (func $hidden)))
  (export "tickets" (instance $api) (instance (type $contract))))
