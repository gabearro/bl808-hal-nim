(component definition $test
  (core type $closure (func (param i32)))
  (core module $tables (table (export "threads") 3 funcref))
  (core instance $tables (instantiate $tables))
  (core func $index (canon thread.index))
  (core func $new (canon thread.new-indirect $closure (core table $tables "threads")))
  (core func $later (canon thread.resume-later))
  (core func $switch (canon thread.suspend-then-resume))
  (core func $promote (canon thread.yield-then-promote))
  (core func $return (canon task.return (result u32)))
  (core func $get (canon context.get i32 1))
  (core func $set (canon context.set i32 1))
  (core module $m
    (import "" "table" (table 3 funcref))
    (import "" "index" (func $index (result i32)))
    (import "" "new" (func $new (param i32 i32) (result i32)))
    (import "" "later" (func $later (param i32)))
    (import "" "switch" (func $switch (param i32) (result i32)))
    (import "" "promote" (func $promote (param i32) (result i32)))
    (import "" "return" (func $return (param i32)))
    (import "" "get" (func $get (result i32)))
    (import "" "set" (func $set (param i32)))
    (global $phase (mut i32) (i32.const 0))
    (global $last (mut i32) (i32.const 0))
    (func $worker (param $parent i32)
      (if (i32.eq (call $index) (local.get $parent)) (then unreachable))
      (if (call $get) (then unreachable))
      (call $set (i32.const 42))
      (global.set $phase (i32.const 1))
      (if (local.get $parent) (then (drop (call $switch (local.get $parent)))))
      (global.set $phase (i32.const 2))
      (call $return (call $get)))
    (func $wrong (result i32) (i32.const 0))
    (elem (i32.const 0) $worker $wrong)
    (func (export "handoff")
      (local $child i32)
      (call $set (i32.const 24))
      (local.set $child (call $new (i32.const 0) (call $index)))
      (drop (call $switch (local.get $child)))
      (if (i32.ne (global.get $phase) (i32.const 1)) (then unreachable))
      (call $later (local.get $child))
      (drop (call $promote (local.get $child)))
      (if (i32.ne (call $get) (i32.const 24)) (then unreachable))
      (if (i32.ne (global.get $phase) (i32.const 2)) (then unreachable)))
    (func (export "detached-completion")
      (global.set $last (call $new (i32.const 0) (i32.const 0)))
      (call $later (global.get $last)))
    (func (export "resume-exited")
      (call $later (global.get $last)))
    (func (export "bad-index") (param i32)
      (drop (call $new (local.get 0) (i32.const 0)))))
  (core instance $m (instantiate $m (with "" (instance
    (export "table" (table $tables "threads")) (export "index" (func $index))
    (export "new" (func $new)) (export "later" (func $later)) (export "switch" (func $switch))
    (export "promote" (func $promote)) (export "return" (func $return))
    (export "get" (func $get)) (export "set" (func $set))))))
  (func (export "handoff") async (result u32) (canon lift (core func $m "handoff") async))
  (func (export "detached-completion") async (result u32)
    (canon lift (core func $m "detached-completion") async))
  (func (export "resume-exited") (canon lift (core func $m "resume-exited")))
  (func (export "bad-index") (param "index" u32) (canon lift (core func $m "bad-index"))))
(component instance $a $test)
(assert_return (invoke "handoff") (u32.const 42))
(component instance $b $test)
(assert_return (invoke "detached-completion") (u32.const 42))
(assert_trap (invoke "resume-exited") "unknown canonical thread index")
(component instance $c $test)
(assert_trap (invoke "bad-index" (u32.const 1)) "canonical thread table entry has the wrong function type")
(component instance $d $test)
(assert_trap (invoke "bad-index" (u32.const 2)) "canonical thread table entry is null")
(component instance $e $test)
(assert_trap (invoke "bad-index" (u32.const 3)) "canonical thread table index out of bounds")

(assert_invalid
  (component
    (core type $closure (func (param i32)))
    (core module $s (table (export "t") 1 externref))
    (core instance $s (instantiate $s))
    (core func (canon thread.new-indirect $closure (core table $s "t"))))
  "canonical thread table must contain funcref")

(component
  (core type $entry (func (param i32)))
  (core module $dispatch
    (table $t (export "t") 2 funcref)
    (func (export "dtor") (param i32)
      (call_indirect (type 0) (local.get 0) (i32.const 0))))
  (core instance $dispatch (instantiate $dispatch))
  (type $r (resource (rep i32) (dtor (core func $dispatch "dtor"))))
  (core func $make (canon resource.new $r))
  (core func $drop (canon resource.drop $r))
  (core func $index (canon thread.index))
  (core func $new (canon thread.new-indirect $entry (core table $dispatch "t")))
  (core func $later (canon thread.resume-later))
  (core func $yield (canon thread.yield))
  (core module $m
    (import "" "t" (table 2 funcref))
    (import "" "make" (func $make (param i32) (result i32)))
    (import "" "drop" (func $drop (param i32)))
    (import "" "index" (func $index (result i32)))
    (import "" "new" (func $new (param i32 i32) (result i32)))
    (import "" "later" (func $later (param i32)))
    (import "" "yield" (func $yield (result i32)))
    (global $caller (mut i32) (i32.const 0))
    (global $value (mut i32) (i32.const 0))
    (func $dtor (param $rep i32)
      (if (i32.eq (call $index) (global.get $caller)) (then unreachable))
      (call $later (call $new (i32.const 1) (local.get $rep)))
      (loop $wait
        (drop (call $yield))
        (br_if $wait (i32.eqz (global.get $value)))))
    (func $worker (param i32) (global.set $value (local.get 0)))
    (elem (i32.const 0) $dtor $worker)
    (func (export "run") (result i32)
      (global.set $caller (call $index))
      (call $drop (call $make (i32.const 42)))
      (global.get $value)))
  (core instance $m (instantiate $m (with "" (instance
    (export "t" (table $dispatch "t")) (export "make" (func $make))
    (export "drop" (func $drop)) (export "index" (func $index))
    (export "new" (func $new)) (export "later" (func $later))
    (export "yield" (func $yield))))))
  (func (export "run") (result u32) (canon lift (core func $m "run"))))
(assert_return (invoke "run") (u32.const 42))
