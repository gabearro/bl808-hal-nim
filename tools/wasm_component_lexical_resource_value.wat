(component
  (component $owner
    (core module $stats
      (global $dropped (mut i32) (i32.const 0))
      (func (export "destroy") (param i32)
        (global.set $dropped (i32.add (global.get $dropped) (local.get 0))))
      (func (export "dropped") (result i32) (global.get $dropped)))
    (core instance $stats (instantiate $stats))
    (type $unused (resource (rep i32)))
    (type $ticket (resource (rep i32) (dtor (core func $stats "destroy"))))
    (export $Ticket "ticket" (type $ticket))
    (core func $new (canon resource.new $ticket))
    (core module $make
      (import "" "new" (func $new (param i32) (result i32)))
      (func (export "make") (param i32) (result i32) (call $new (local.get 0))))
    (core instance $make (instantiate $make (with "" (instance (export "new" (func $new))))))
    (func (export "make") (param "value" u32) (result (own $Ticket))
      (canon lift (core func $make "make")))
    (func (export "dropped") (result u32) (canon lift (core func $stats "dropped")))

    (type $Contract (component
      (alias outer 1 $Ticket (type $T))
      (import "ticket" (type $In (eq $T)))
      (export "inspect" (func (param "value" (borrow $In)) (result u32)))))
    (component $provider
      (import "ticket" (type $Token (sub resource)))
      (core func $release (canon resource.drop $Token))
      (core module $inspect
        (import "" "release" (func $release (param i32)))
        (func (export "inspect") (param i32) (result i32)
          (call $release (local.get 0)) (i32.const 42)))
      (core instance $inspect (instantiate $inspect (with "" (instance (export "release" (func $release))))))
      (func (export "inspect") (param "value" (borrow $Token)) (result u32)
        (canon lift (core func $inspect "inspect"))))
    (export $Typed "typed" (component $provider) (component (type $Contract)))

    (component $relay
      (alias outer 1 $Typed (component $Captured))
      (export "factory" (component $Captured)))
    (type $RelayType (component
      (alias outer 1 $Contract (type $FactoryType))
      (export "factory" (component (type $FactoryType)))))
    (export $TypedRelay "relay" (component $relay) (component (type $RelayType)))
    (instance $relay (instantiate $TypedRelay))
    (export "factory" (component $relay "factory")))

  (instance $first (instantiate $owner))
  (instance $second (instantiate $owner))
  (alias export $first "ticket" (type $First))
  (alias export $second "ticket" (type $Second))
  (alias export $first "factory" (component $A))
  (alias export $second "factory" (component $B))
  (instance $a (instantiate $A (with "ticket" (type $First))))
  (instance $b (instantiate $B (with "ticket" (type $Second))))
  (core func $make-a (canon lower (func $first "make")))
  (core func $make-b (canon lower (func $second "make")))
  (core func $inspect-a (canon lower (func $a "inspect")))
  (core func $inspect-b (canon lower (func $b "inspect")))
  (core func $drop-a (canon resource.drop $First))
  (core func $drop-b (canon resource.drop $Second))
  (core func $dropped-a (canon lower (func $first "dropped")))
  (core func $dropped-b (canon lower (func $second "dropped")))
  (core module $entry
    (import "" "make-a" (func $make-a (param i32) (result i32)))
    (import "" "make-b" (func $make-b (param i32) (result i32)))
    (import "" "inspect-a" (func $inspect-a (param i32) (result i32)))
    (import "" "inspect-b" (func $inspect-b (param i32) (result i32)))
    (import "" "drop-a" (func $drop-a (param i32)))
    (import "" "drop-b" (func $drop-b (param i32)))
    (import "" "dropped-a" (func $dropped-a (result i32)))
    (import "" "dropped-b" (func $dropped-b (result i32)))
    (func (export "run") (result i32) (local $a i32) (local $b i32)
      (local.set $a (call $make-a (i32.const 19)))
      (local.set $b (call $make-b (i32.const 23)))
      (if (i32.ne (call $inspect-a (local.get $a)) (i32.const 42)) (then unreachable))
      (if (i32.ne (call $inspect-b (local.get $b)) (i32.const 42)) (then unreachable))
      (call $drop-a (local.get $a))
      (call $drop-b (local.get $b))
      (if (i32.ne (call $dropped-a) (i32.const 19)) (then unreachable))
      (if (i32.ne (call $dropped-b) (i32.const 23)) (then unreachable))
      (i32.const 42)))
  (core instance $entry (instantiate $entry (with "" (instance
    (export "make-a" (func $make-a)) (export "make-b" (func $make-b))
    (export "inspect-a" (func $inspect-a)) (export "inspect-b" (func $inspect-b))
    (export "drop-a" (func $drop-a)) (export "drop-b" (func $drop-b))
    (export "dropped-a" (func $dropped-a)) (export "dropped-b" (func $dropped-b))))))
  (func (export "run") (result u32) (canon lift (core func $entry "run"))))
