(component
  (type $unit (future))
  (core func $new (canon future.new $unit))
  (core func $read (canon future.read $unit))
  (core func $write (canon future.write $unit async))
  (core func $filled (canon task.return))
  (core func $return (canon task.return (result u32)))
  (core module $m
    (import "" "n" (func $new (result i64)))
    (import "" "r" (func $read (param i32 i32) (result i32)))
    (import "" "w" (func $write (param i32 i32) (result i32)))
    (import "" "r0" (func $filled))
    (import "" "r1" (func $return (param i32)))
    (global $writer (mut i32) (i32.const 0))
    (func (export "run")
      (local $pair i64)
      (local.set $pair (call $new))
      (global.set $writer (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32))))
      (if (call $read (i32.wrap_i64 (local.get $pair)) (i32.const -1)) (then unreachable))
      (call $return (i32.const 42)))
    (func (export "fill")
      (if (call $write (global.get $writer) (i32.const -1)) (then unreachable))
      (call $filled)))
  (core instance $i (instantiate $m (with "" (instance
    (export "n" (func $new)) (export "r" (func $read)) (export "w" (func $write))
    (export "r0" (func $filled)) (export "r1" (func $return))))))
  (func (export "run") async (result u32) (canon lift (core func $i "run") async))
  (func (export "fill") async (canon lift (core func $i "fill") async)))
