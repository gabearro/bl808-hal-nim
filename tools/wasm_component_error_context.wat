(component
  (component $echo
    (core module $core (func (export "pass") (param i32) (result i32) (local.get 0)))
    (core instance $core (instantiate $core))
    (func (export "pass") (param "context" error-context) (result error-context)
      (canon lift (core func $core "pass"))))
  (instance $echo (instantiate $echo))
  (core module $support
    (memory (export "mem") 1)
    (data (i32.const 0) "\e9\00d\00")
    (data (i32.const 8) "\00\d8")
    (func (export "realloc") (param i32 i32 i32 i32) (result i32) (i32.const 128)))
  (core instance $support (instantiate $support))
  (alias core export $support "mem" (core memory $mem))
  (alias core export $support "realloc" (core func $realloc))
  (core func $new (canon error-context.new (memory $mem) string-encoding=utf16))
  (core func $debug (canon error-context.debug-message (memory $mem) (realloc $realloc)))
  (core func $drop (canon error-context.drop))
  (core func $pass (canon lower (func $echo "pass")))
  (type $resource (resource (rep i32)))
  (core func $new-resource (canon resource.new $resource))
  (core func $drop-resource (canon resource.drop $resource))
  (core module $app
    (import "" "mem" (memory 1))
    (import "" "new" (func $new (param i32 i32) (result i32)))
    (import "" "debug" (func $debug (param i32 i32)))
    (import "" "drop" (func $drop (param i32)))
    (import "" "pass" (func $pass (param i32) (result i32)))
    (import "" "new-resource" (func $new-resource (param i32) (result i32)))
    (import "" "drop-resource" (func $drop-resource (param i32)))
    (func (export "new") (result i32) (call $new (i32.const 0) (i32.const 2)))
    (func (export "new-oob") (result i32) (call $new (i32.const -2) (i32.const 1)))
    (func (export "new-invalid") (result i32) (call $new (i32.const 8) (i32.const 1)))
    (func (export "transfer") (param $source i32) (result i32)
      (local $copy i32)
      (local.set $copy (call $pass (local.get $source)))
      (if (i32.eq (local.get $copy) (local.get $source)) (then unreachable))
      (call $drop (local.get $source))
      (local.get $copy))
    (func (export "describe") (param $context i32) (result i32)
      (call $debug (local.get $context) (i32.const 32))
      (call $drop (local.get $context))
      (i32.const 32))
    (func (export "detail") (param $context i32) (param $code i32) (result i32)
      (i32.store (i32.const 40) (local.get $context))
      (i32.store (i32.const 44) (local.get $code))
      (i32.const 40))
    (func (export "drop") (param i32) (call $drop (local.get 0)))
    (func (export "invalid-drop")
      (local $context i32)
      (local.set $context (call $new (i32.const 0) (i32.const 0)))
      (call $drop (local.get $context))
      (call $drop (local.get $context)))
    (func (export "resource-as-context")
      (call $drop (call $new-resource (i32.const 0))))
    (func (export "context-as-resource")
      (call $drop-resource (call $new (i32.const 0) (i32.const 0))))
    (func (export "invalid-lift") (result i32) (i32.const 0))
    (func (export "debug-unaligned") (param i32)
      (call $debug (local.get 0) (i32.const 33)))
    (func (export "debug-oob") (param i32)
      (call $debug (local.get 0) (i32.const 65532))))
  (core instance $app (instantiate $app (with "" (instance
    (export "mem" (memory $mem)) (export "new" (func $new)) (export "debug" (func $debug))
    (export "drop" (func $drop)) (export "pass" (func $pass))
    (export "new-resource" (func $new-resource)) (export "drop-resource" (func $drop-resource))))))
  (type $detail (record (field "context" error-context) (field "code" u32)))
  (export $detail-public "error-detail" (type $detail))
  (func (export "new") (result error-context) (canon lift (core func $app "new")))
  (func (export "new-oob") (result error-context) (canon lift (core func $app "new-oob")))
  (func (export "new-invalid") (result error-context) (canon lift (core func $app "new-invalid")))
  (func (export "transfer") (param "context" error-context) (result error-context)
    (canon lift (core func $app "transfer")))
  (func (export "describe") (param "context" error-context) (result string)
    (canon lift (core func $app "describe") (memory $mem)))
  (func (export "detail") (param "detail" $detail-public) (result $detail-public)
    (canon lift (core func $app "detail") (memory $mem)))
  (func (export "drop") (param "context" error-context) (canon lift (core func $app "drop")))
  (func (export "invalid-drop") (canon lift (core func $app "invalid-drop")))
  (func (export "resource-as-context") (canon lift (core func $app "resource-as-context")))
  (func (export "context-as-resource") (canon lift (core func $app "context-as-resource")))
  (func (export "invalid-lift") (result error-context) (canon lift (core func $app "invalid-lift")))
  (func (export "debug-unaligned") (param "context" error-context) (canon lift (core func $app "debug-unaligned")))
  (func (export "debug-oob") (param "context" error-context) (canon lift (core func $app "debug-oob"))))
