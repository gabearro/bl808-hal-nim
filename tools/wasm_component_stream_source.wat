(component
  (type $unit (stream))
  (core func $new (canon stream.new $unit))
  (core func $write (canon stream.write $unit async))
  (core func $read (canon stream.read $unit async))
  (core func $cancel (canon stream.cancel-write $unit))
  (core module $m
    (import "" "n" (func $new (result i64)))
    (import "" "w" (func $write (param i32 i32 i32) (result i32)))
    (import "" "r" (func $read (param i32 i32 i32) (result i32)))
    (import "" "c" (func $cancel (param i32) (result i32)))
    (global $writer (mut i32) (i32.const 0))
    (func (export "make") (result i32)
      (local $pair i64)
      (local.set $pair (call $new))
      (global.set $writer (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32))))
      (if (i32.ne (call $write (global.get $writer) (i32.const -1) (i32.const 4))
                  (i32.const -1)) (then unreachable))
      (i32.wrap_i64 (local.get $pair)))
    (func (export "consume") (param $reader i32) (result i32)
      (if (i32.ne (call $read (local.get $reader) (i32.const -1) (i32.const 1))
                  (i32.const 0x10)) (then unreachable))
      (if (i32.ne (call $read (local.get $reader) (i32.const -1) (i32.const 2))
                  (i32.const 0x20)) (then unreachable))
      (if (i32.ne (call $cancel (global.get $writer)) (i32.const 0x32))
        (then unreachable))
      (i32.const 42)))
  (core instance $m (instantiate $m (with "" (instance
    (export "n" (func $new)) (export "w" (func $write)) (export "r" (func $read))
    (export "c" (func $cancel))))))
  (func (export "make") (result $unit) (canon lift (core func $m "make")))
  (func (export "consume") (param "reader" $unit) (result u32)
    (canon lift (core func $m "consume"))))
