(module
  (memory (export "cm32p2_memory") 1)
  (global $next (mut i32) (i32.const 32))
  (func (export "cm32p2_realloc") (param i32 i32 i32 i32) (result i32)
    (local $mask i32) (local $pointer i32)
    (local.set $mask (i32.sub (local.get 2) (i32.const 1)))
    (local.set $pointer
      (i32.and (i32.add (global.get $next) (local.get $mask))
               (i32.xor (local.get $mask) (i32.const -1))))
    (global.set $next (i32.add (local.get $pointer) (local.get 3)))
    (local.get $pointer))
  (func (export "cm32p2||echo") (param $values i32) (param $count i32)
    (param $malformed i32) (result i32)
    (if (i32.eq (local.get $malformed) (i32.const 1))
      (then (i32.store (local.get $values) (i32.const 17))))
    (if (i32.eq (local.get $malformed) (i32.const 2))
      (then (i32.store offset=4 (local.get $values) (i32.const 2147483647))))
    (if (i32.eq (local.get $malformed) (i32.const 3))
      (then (i32.store (local.get $values) (i32.const 65536))))
    (i32.store (i32.const 0) (local.get $values))
    (i32.store (i32.const 4) (local.get $count))
    (i32.const 0))
)
