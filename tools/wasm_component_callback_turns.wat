(module
  (import "$root" "[context-get-0]" (func $get (result i32)))
  (import "$root" "[context-set-0]" (func $set (param i32)))
  (import "[export]$root" "[task-return]run" (func $return (param i32)))
  (func (export "[async-lift]run") (param i32) (result i32)
    (if (call $get) (then unreachable))
    (call $set (i32.add (local.get 0) (i32.const 1)))
    (i32.const 1))
  (func (export "[callback][async-lift]run") (param i32 i32 i32) (result i32)
    (if (i32.or (local.get 0) (i32.or (local.get 1) (local.get 2)))
      (then unreachable))
    (if (i32.eq (call $get) (i32.const -1)) (then (return (i32.const 0))))
    (call $return (call $get))
    (call $set (i32.const -1))
    (i32.const 1)))
