(component
  (core module $memory
    (memory (export "buffer") 1)
    (global $last (mut i32) (i32.const 0))
    (func (export "drop") (param i32) (global.set $last (local.get 0)))
    (func (export "observed") (result i32) (global.get $last))
    (data (i32.const 32) "Ox64")
    (data (i32.const 64) "\01\00\00\00")
    (data (i32.const 128) "\11\00\00\00"))
  (core instance $first (instantiate $memory))
  (core instance $second (instantiate $memory))
  (alias core export $first "buffer" (core memory $buffer))
  (alias core export $second "buffer" (core memory $other))
  (core func $return (canon task.return (result string) (memory $buffer)))
  (type $pair (tuple u32 u64))
  (type $wide (tuple u32 u32 u32 u32 u32 u32 u32 u32 u32
                     u32 u32 u32 u32 u32 u32 u32 u32))
  (core func $return-pair (canon task.return (result $pair)))
  (core func $return-wide (canon task.return (result $wide) (memory $buffer)))
  (type $ticket (resource (rep i32) (dtor (core func $first "drop"))))
  (export $named "ticket" (type $ticket))
  (core func $new (canon resource.new $ticket))
  (core func $return-owned (canon task.return (result (own $named))))
  (core module $m
    (import "" "return" (func $return (param i32 i32)))
    (import "" "return-pair" (func $return-pair (param i32 i64)))
    (import "" "return-wide" (func $return-wide (param i32)))
    (import "" "new" (func $new (param i32) (result i32)))
    (import "" "return-owned" (func $return-owned (param i32)))
    (func (export "start") (result i32) (i32.const 1))
    (func (export "callback") (param i32 i32 i32) (result i32)
      (call $return (i32.const 32) (i32.const 4))
      (i32.const 0))
    (func (export "callback-pair") (param i32 i32 i32) (result i32)
      (call $return-pair (i32.const 42) (i64.const 4294967297))
      (i32.const 0))
    (func (export "callback-wide") (param i32 i32 i32) (result i32)
      (call $return-wide (i32.const 64))
      (i32.const 0))
    (func (export "callback-owned") (param i32 i32 i32) (result i32)
      (call $return-owned (call $new (i32.const 42)))
      (i32.const 0)))
  (core instance $i (instantiate $m (with "" (instance
    (export "return" (func $return))
    (export "return-pair" (func $return-pair))
    (export "return-wide" (func $return-wide))
    (export "new" (func $new))
    (export "return-owned" (func $return-owned))))))
  (func $text async (result string)
    (canon lift (core func $i "start") (memory $buffer) async
      (callback (core func $i "callback"))))
  (func (export "wrong-memory") async (result string)
    (canon lift (core func $i "start") (memory $other) async
      (callback (core func $i "callback"))))
  (func (export "pair") async (result $pair)
    (canon lift (core func $i "start") async (callback (core func $i "callback-pair"))))
  (func (export "wide") async (result $wide)
    (canon lift (core func $i "start") (memory $buffer) async
      (callback (core func $i "callback-wide"))))
  (func (export "owned") async (result (own $named))
    (canon lift (core func $i "start") async (callback (core func $i "callback-owned"))))
  (func (export "observed") (result u32) (canon lift (core func $first "observed")))
  (instance $inner (export "text" (func $text)))
  (instance $api (export "inner" (instance $inner)))
  (export "api" (instance $api)))
