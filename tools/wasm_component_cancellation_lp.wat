(component
  (component $worker
    (core func $cancel (canon task.cancel))
    (core func $arm (canon backpressure.inc))
    (core func $release (canon backpressure.dec))
    (core module $m
      (import "" "c" (func $cancel))
      (func (export "s") (param i32) (result i32)
        (if (i32.eqz (local.get 0)) (then unreachable))
        (i32.const 1))
      (func (export "n") (param i32 i32 i32) (result i32)
        (if (i32.ne (local.get 0) (i32.const 6)) (then unreachable))
        (if (i32.or (local.get 1) (local.get 2)) (then unreachable))
        (call $cancel)
        (i32.const 0)))
    (core instance $i (instantiate $m (with "" (instance (export "c" (func $cancel))))))
    (func (export "work") async (param "mode" u32)
      (canon lift (core func $i "s") async (callback (core func $i "n"))))
    (func (export "arm") (canon lift (core func $arm)))
    (func (export "release") (canon lift (core func $release))))
  (instance $worker (instantiate $worker))
  (core func $work (canon lower (func $worker "work") async))
  (core func $arm (canon lower (func $worker "arm")))
  (core func $release (canon lower (func $worker "release")))
  (core func $cancel (canon subtask.cancel))
  (core func $drop (canon subtask.drop))
  (core func $return (canon task.return))
  (core module $m
    (import "" "w" (func $work (param i32) (result i32)))
    (import "" "a" (func $arm))
    (import "" "r" (func $release))
    (import "" "c" (func $cancel (param i32) (result i32)))
    (import "" "d" (func $drop (param i32)))
    (import "" "t" (func $return))
    (func (export "s") (param $mode i32) (result i32)
      (local $handle i32)
      (if (i32.eqz (local.get $mode)) (then (call $arm)))
      (local.set $handle (i32.shr_u (call $work (local.get $mode)) (i32.const 4)))
      (if (i32.ne (call $cancel (local.get $handle)) (i32.add (local.get $mode) (i32.const 3)))
        (then unreachable))
      (call $drop (local.get $handle))
      (if (i32.eqz (local.get $mode)) (then (call $release)))
      (call $return)
      (i32.const 0))
    (func (export "n") (param i32 i32 i32) (result i32) unreachable))
  (core instance $i (instantiate $m (with "" (instance
    (export "w" (func $work)) (export "a" (func $arm)) (export "r" (func $release))
    (export "c" (func $cancel)) (export "d" (func $drop)) (export "t" (func $return))))))
  (func (export "run") async (param "mode" u32)
    (canon lift (core func $i "s") async (callback (core func $i "n")))))
