  (func (export "priority") async (result u32)
    (canon lift (core func $caller "priority") async (callback (core func $caller "never")))))

(assert_return (invoke "flat") (u32.const 42))
(assert_return (invoke "indirect") (u32.const 42))
(assert_return (invoke "priority") (u32.const 42))
