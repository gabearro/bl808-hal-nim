(component
  (component $worker
    (core func $return (canon task.return (result u32)))
    (core module $m
      (import "" "return" (func $return (param i32)))
      (global $argument (mut i32) (i32.const 0))
      (global $finished (mut i32) (i32.const 0))
      (func (export "entry") (param i32) (result i32)
        (global.set $argument (local.get 0))
        (i32.const 1))
      (func (export "next") (param i32 i32 i32) (result i32)
        (if (global.get $argument)
          (then
            (call $return (i32.add (global.get $argument) (i32.const 1)))
            (global.set $argument (i32.const 0))
            (return (i32.const 1))))
        (global.set $finished (i32.const 1))
        (i32.const 0))
      (func (export "finished") (result i32) (global.get $finished)))
    (core instance $i (instantiate $m (with "" (instance (export "return" (func $return))))))
    (func (export "produce") async (param "value" u32) (result u32)
      (canon lift (core func $i "entry") async (callback (core func $i "next"))))
    (func (export "finished") (result u32) (canon lift (core func $i "finished"))))

  (instance $worker (instantiate $worker))
  (core func $produce (canon lower (func $worker "produce")))
  (core func $finished (canon lower (func $worker "finished")))
  (core func $yield (canon thread.yield))
  (core func $return (canon task.return (result u32)))
  (core func $done (canon task.return))
  (core func $inc (canon backpressure.inc))
  (core func $dec (canon backpressure.dec))
  (core func $get (canon context.get i32 0))
  (core func $set (canon context.set i32 0))
  (core module $storage
    (import "" "yield" (func $yield (result i32)))
    (import "" "return" (func $return (param i32)))
    (import "" "done" (func $done))
    (import "" "dec" (func $dec))
    (import "" "get" (func $get (result i32)))
    (import "" "set" (func $set (param i32)))
    (memory (export "mem") 1)
    (data (i32.const 0) "\10\00\00\00\03\00\00\00old\00\00\00\00\00out")
    (global $allocations (mut i32) (i32.const 0))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (global.set $allocations (i32.add (global.get $allocations) (i32.const 1)))
      (i32.add (i32.const 16) (i32.shl (global.get $allocations) (i32.const 4))))
    (func (export "release")
      (if (call $yield) (then unreachable))
      ;; The input is changed while text is still waiting to start.
      (i32.store8 (i32.const 8) (i32.const 110))
      (i32.store8 (i32.const 9) (i32.const 101))
      (i32.store8 (i32.const 10) (i32.const 119))
      (call $dec)
      (call $done))
    (func (export "exclusive") unreachable)
    (func (export "unlocked")
      (if (call $yield) (then unreachable))
      (call $return (i32.const 42)))
    (func (export "text") (param $ptr i32) (param $len i32) (result i32)
      (call $set (i32.const 42))
      (if (call $yield) (then unreachable))
      (if (i32.ne (call $get) (i32.const 42)) (then unreachable))
      (if (i32.ne (local.get $len) (i32.const 3)) (then unreachable))
      (if (i32.ne (i32.load8_u (local.get $ptr)) (i32.const 110)) (then unreachable))
      (i32.const 0))
    (func (export "post") (param i32)
      (if (i32.ne (local.get 0) (i32.const 0)) (then unreachable))
      (if (i32.ne (call $get) (i32.const 42)) (then unreachable))
      ;; The caller's realloc and return-area stores precede post-return.
      (if (i32.ne (global.get $allocations) (i32.const 2)) (then unreachable))
      (if (i32.ne (i32.load (i32.const 64)) (i32.const 48)) (then unreachable))
      (i32.store8 (i32.const 16) (i32.const 0))
      (i32.store8 (i32.const 72) (i32.const 1))))
  (core instance $storage (instantiate $storage (with "" (instance
    (export "yield" (func $yield)) (export "done" (func $done))
    (export "return" (func $return))
    (export "dec" (func $dec)) (export "get" (func $get)) (export "set" (func $set))))))
  (alias core export $storage "mem" (core memory $mem))
  (alias core export $storage "realloc" (core func $realloc))
  (func $release async (canon lift (core func $storage "release") async))
  (func $exclusive async (canon lift (core func $storage "exclusive")))
  (func $unlocked async (result u32) (canon lift (core func $storage "unlocked") async))
  (func $text async (param "input" string) (result string)
    (canon lift (core func $storage "text") (memory $mem) (realloc $realloc)
      (post-return (core func $storage "post"))))
  (core func $release (canon lower (func $release) async))
  (core func $exclusive (canon lower (func $exclusive) async))
  (core func $unlocked (canon lower (func $unlocked)))
  (core func $cancel (canon subtask.cancel))
  (core func $text (canon lower (func $text) (memory $mem) (realloc $realloc)))
  (core func $new (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $wait (canon waitable-set.wait (memory $mem)))
  (core func $drop-task (canon subtask.drop))
  (core func $drop-set (canon waitable-set.drop))
  (core module $caller
    (import "" "mem" (memory 1))
    (import "" "produce" (func $produce (param i32) (result i32)))
    (import "" "finished" (func $finished (result i32)))
    (import "" "return" (func $return (param i32)))
    (import "" "release" (func $release (result i32)))
    (import "" "exclusive" (func $exclusive (result i32)))
    (import "" "unlocked" (func $unlocked (result i32)))
    (import "" "cancel" (func $cancel (param i32) (result i32)))
    (import "" "inc" (func $inc))
    (import "" "text" (func $text (param i32 i32 i32)))
    (import "" "new" (func $new (result i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "wait" (func $wait (param i32 i32) (result i32)))
    (import "" "drop-task" (func $drop-task (param i32)))
    (import "" "drop-set" (func $drop-set (param i32)))
    (func (export "flat")
      (local $answer i32)
      (local.set $answer (call $produce (i32.const 41)))
      (if (call $finished) (then unreachable))
      (call $return (local.get $answer)))
    (func (export "priority") (result i32)
      (local $status i32) (local $answer i32)
      ;; Queue a task that needs the lock this callback owns.
      (local.set $status (call $exclusive))
      (if (i32.and (local.get $status) (i32.const 15)) (then unreachable))
      (local.set $status (i32.shr_u (local.get $status) (i32.const 4)))
      ;; The stackful task may run while the earlier entry waits for the lock.
      (local.set $answer (call $unlocked))
      (if (i32.ne (call $cancel (local.get $status)) (i32.const 3)) (then unreachable))
      (call $drop-task (local.get $status))
      (call $return (local.get $answer))
      (i32.const 0))
    (func (export "never") (param i32 i32 i32) (result i32) unreachable)
    (func (export "indirect")
      (local $handle i32) (local $set i32) (local $ptr i32)
      (local.set $handle (call $release))
      (if (i32.ne (i32.and (local.get $handle) (i32.const 15)) (i32.const 1)) (then unreachable))
      (local.set $handle (i32.shr_u (local.get $handle) (i32.const 4)))
      (local.set $set (call $new))
      (call $join (local.get $handle) (local.get $set))
      (call $inc)
      (call $text (i32.const 8) (i32.const 3) (i32.const 64))
      (if (i32.ne (i32.load8_u (i32.const 72)) (i32.const 1)) (then unreachable))
      (local.set $ptr (i32.load (i32.const 64)))
      (if (i32.ne (i32.load (i32.const 68)) (i32.const 3)) (then unreachable))
      (if (i32.ne (i32.load8_u (local.get $ptr)) (i32.const 111)) (then unreachable))
      (if (i32.ne (call $wait (local.get $set) (i32.const 80)) (i32.const 1)) (then unreachable))
      (if (i32.ne (i32.load (i32.const 80)) (local.get $handle)) (then unreachable))
      (if (i32.ne (i32.load (i32.const 84)) (i32.const 2)) (then unreachable))
      (call $drop-task (local.get $handle))
      (call $drop-set (local.get $set))
      (call $return (i32.const 42))))
  (core instance $caller (instantiate $caller (with "" (instance
    (export "mem" (memory $mem))
    (export "produce" (func $produce)) (export "finished" (func $finished))
    (export "return" (func $return)) (export "release" (func $release))
    (export "exclusive" (func $exclusive)) (export "unlocked" (func $unlocked))
    (export "cancel" (func $cancel))
    (export "inc" (func $inc)) (export "text" (func $text))
    (export "new" (func $new)) (export "join" (func $join))
    (export "wait" (func $wait)) (export "drop-task" (func $drop-task))
    (export "drop-set" (func $drop-set))))))
  (func (export "flat") async (result u32)
