;; Two suspending guest stacks in one worker instance and a caller blocked on
;; that instance's subtasks. Each task keeps its original context and locals.
(component
  (component $worker
    (core func $yield (canon thread.yield))
    (core func $return (canon task.return (result u32)))
    (core func $cancel (canon task.cancel))
    (core func $get (canon context.get i32 0))
    (core func $set (canon context.set i32 0))
    (core module $m
      (import "" "yield" (func $yield (result i32)))
      (import "" "return" (func $return (param i32)))
      (import "" "cancel" (func $cancel))
      (import "" "get" (func $get (result i32)))
      (import "" "set" (func $set (param i32)))
      (func $pause (param $x i32) (result i32)
        (call $set (local.get $x))
        (if (call $yield) (then unreachable))
        (if (i32.ne (call $get) (local.get $x)) (then unreachable))
        (i32.add (local.get $x) (call $get)))
      (func (export "compute") (param $x i32)
        (call $return (call $pause (local.get $x))))
      (func (export "cancellable") (result i32) (i32.const 1))
      (func (export "callback") (param $event i32) (param i32 i32) (result i32)
        (if (i32.ne (local.get $event) (i32.const 6)) (then unreachable))
        (if (call $yield) (then unreachable))
        (call $cancel)
        (i32.const 0)))
    (core instance $i (instantiate $m (with "" (instance
      (export "yield" (func $yield)) (export "return" (func $return))
      (export "cancel" (func $cancel))
      (export "get" (func $get)) (export "set" (func $set))))))
    (func (export "compute") async (param "x" u32) (result u32)
      (canon lift (core func $i "compute") async))
    (func (export "cancellable") async
      (canon lift (core func $i "cancellable") async (callback (core func $i "callback")))))
  (instance $worker (instantiate $worker))
  (core module $memory (memory (export "mem") 1))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "mem" (core memory $mem))
  (core func $compute (canon lower (func $worker "compute") async (memory $mem)))
  (core func $start (canon lower (func $worker "cancellable") async))
  (core func $cancel (canon subtask.cancel))
  (core func $new (canon waitable-set.new))
  (core func $drop (canon waitable-set.drop))
  (core func $wait (canon waitable-set.wait (memory $mem)))
  (core func $join (canon waitable.join))
  (core func $drop-task (canon subtask.drop))
  (core func $return (canon task.return (result u32)))
  (core module $m
    (import "" "mem" (memory 1))
    (import "" "compute" (func $compute (param i32 i32) (result i32)))
    (import "" "start" (func $start (result i32)))
    (import "" "cancel" (func $cancel (param i32) (result i32)))
    (import "" "new" (func $new (result i32)))
    (import "" "drop" (func $drop (param i32)))
    (import "" "wait" (func $wait (param i32 i32) (result i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "drop-task" (func $drop-task (param i32)))
    (import "" "return" (func $return (param i32)))
    (func $started (param $status i32) (result i32)
      (if (i32.ne (i32.and (local.get $status) (i32.const 15)) (i32.const 1))
        (then unreachable))
      (i32.shr_u (local.get $status) (i32.const 4)))
    (func $collect (param $ws i32) (result i32)
      (local $handle i32)
      (if (i32.ne (call $wait (local.get $ws) (i32.const 0)) (i32.const 1))
        (then unreachable))
      (if (i32.ne (i32.load (i32.const 4)) (i32.const 2)) (then unreachable))
      (local.set $handle (i32.load (i32.const 0)))
      (call $drop-task (local.get $handle))
      (local.get $handle))
    (func (export "run")
      (local $ws i32) (local $first i32) (local $second i32) (local $done i32)
      (local.set $ws (call $new))
      (local.set $first (call $started (call $compute (i32.const 20) (i32.const 8))))
      (local.set $second (call $started (call $compute (i32.const 21) (i32.const 12))))
      (call $join (local.get $first) (local.get $ws))
      (call $join (local.get $second) (local.get $ws))
      (local.set $done (call $collect (local.get $ws)))
      (if (i32.ne (i32.xor (local.get $done) (call $collect (local.get $ws)))
          (i32.xor (local.get $first) (local.get $second))) (then unreachable))
      (call $drop (local.get $ws))
      (if (i32.ne (i32.load (i32.const 8)) (i32.const 40)) (then unreachable))
      (call $return (i32.load (i32.const 12))))
    (func (export "cancel")
      (local $handle i32)
      (local.set $handle (call $started (call $start)))
      (call $return (call $cancel (local.get $handle)))
      (call $drop-task (local.get $handle))))
  (core instance $i (instantiate $m (with "" (instance
    (export "mem" (memory $mem))
    (export "compute" (func $compute)) (export "start" (func $start))
    (export "cancel" (func $cancel)) (export "new" (func $new))
    (export "drop" (func $drop)) (export "wait" (func $wait))
    (export "join" (func $join)) (export "drop-task" (func $drop-task))
    (export "return" (func $return))))))
  (func (export "run") async (result u32) (canon lift (core func $i "run") async))
  (func (export "cancel") async (result u32) (canon lift (core func $i "cancel") async)))

(assert_return (invoke "run") (u32.const 42))
(assert_return (invoke "cancel") (u32.const 4))
(assert_return (invoke "run") (u32.const 42))
