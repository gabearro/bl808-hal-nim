(component
  (type $r (resource (rep i32)))
  (export $named "r" (type $r))
  (core func $new (canon resource.new $r))
  (core func $drop (canon resource.drop $r))
  (component $worker
    (import "r" (type $r (sub resource)))
    (core func $drop (canon resource.drop $r))
    (core func $cancel (canon task.cancel))
    (core module $m
      (import "" "d" (func $drop (param i32)))
      (import "" "c" (func $cancel))
      (global $handle (mut i32) (i32.const 0))
      (func (export "s") (param i32) (result i32)
        (global.set $handle (local.get 0))
        (i32.const 1))
      (func (export "n") (param i32 i32 i32) (result i32)
        (if (i32.ne (local.get 0) (i32.const 6)) (then unreachable))
        (call $drop (global.get $handle))
        (call $cancel)
        (i32.const 0)))
    (core instance $i (instantiate $m (with "" (instance
      (export "d" (func $drop)) (export "c" (func $cancel))))))
    (func (export "work") async (param "r" (borrow $r))
      (canon lift (core func $i "s") async (callback (core func $i "n")))))
  (instance $worker (instantiate $worker (with "r" (type $named))))
  (core func $work (canon lower (func $worker "work") async))
  (core func $cancel (canon subtask.cancel))
  (core func $drop-task (canon subtask.drop))
  (core func $return (canon task.return (result u32)))
  (core module $m
    (import "" "n" (func $new (param i32) (result i32)))
    (import "" "d" (func $drop (param i32)))
    (import "" "w" (func $work (param i32) (result i32)))
    (import "" "c" (func $cancel (param i32) (result i32)))
    (import "" "t" (func $drop-task (param i32)))
    (import "" "r" (func $return (param i32)))
    (func (export "s") (result i32)
      (local $own i32) (local $subtask i32)
      (local.set $own (call $new (i32.const 42)))
      (local.set $subtask (i32.shr_u (call $work (local.get $own)) (i32.const 4)))
      (if (i32.ne (call $cancel (local.get $subtask)) (i32.const 4)) (then unreachable))
      (call $drop-task (local.get $subtask))
      (call $drop (local.get $own))
      (call $return (i32.const 42))
      (i32.const 0))
    (func (export "n") (param i32 i32 i32) (result i32) unreachable))
  (core instance $i (instantiate $m (with "" (instance
    (export "n" (func $new)) (export "d" (func $drop)) (export "w" (func $work))
    (export "c" (func $cancel)) (export "t" (func $drop-task)) (export "r" (func $return))))))
  (func (export "run") async (result u32)
    (canon lift (core func $i "s") async (callback (core func $i "n")))))
