(component
  (component $callee
    (core func $return (canon task.return))
    (core module $m
      (import "" "return" (func $return))
      (func (export "start") (result i32) (i32.const 1))
      (func (export "next") (param i32 i32 i32) (result i32)
        (call $return) (i32.const 0)))
    (core instance $i (instantiate $m (with "" (instance (export "return" (func $return))))))
    (func (export "task") async
      (canon lift (core func $i "start") async (callback (core func $i "next")))))
  (instance $callee (instantiate $callee))
  (core func $lower (canon lower (func $callee "task") async))
  (core func $new (canon waitable-set.new))
  (core func $join (canon waitable.join))
  (core func $drop-task (canon subtask.drop))
  (core func $drop-set (canon waitable-set.drop))
  (core func $return (canon task.return (result u32)))
  (core module $m
    (import "" "lower" (func $lower (result i32)))
    (import "" "new" (func $new (result i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "drop-task" (func $drop-task (param i32)))
    (import "" "drop-set" (func $drop-set (param i32)))
    (import "" "return" (func $return (param i32)))
    (global $set (mut i32) (i32.const 0))
    (func (export "start") (result i32)
      (global.set $set (call $new))
      (if (i32.ne (call $lower) (i32.const 0x21)) (then unreachable))
      (call $join (i32.const 2) (global.get $set))
      (i32.or (i32.shl (global.get $set) (i32.const 4)) (i32.const 2)))
    (func (export "next") (param $code i32) (param $id i32) (param $state i32) (result i32)
      (if (i32.ne (local.get $code) (i32.const 1)) (then unreachable))
      (if (i32.ne (local.get $id) (i32.const 2)) (then unreachable))
      (if (i32.ne (local.get $state) (i32.const 2)) (then unreachable))
      (call $drop-task (local.get $id))
      (call $drop-set (global.get $set))
      (call $return (i32.const 42))
      (i32.const 0)))
  (core instance $i (instantiate $m (with "" (instance
    (export "lower" (func $lower)) (export "new" (func $new)) (export "join" (func $join))
    (export "drop-task" (func $drop-task)) (export "drop-set" (func $drop-set))
    (export "return" (func $return))))))
  (func (export "run") async (result u32)
    (canon lift (core func $i "start") async (callback (core func $i "next")))))
