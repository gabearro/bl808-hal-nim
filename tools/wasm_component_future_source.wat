(component
  (type $future (future u8))
  (core module $memory (memory (export "mem") 1))
  (core instance $memory (instantiate $memory))
  (core func $new (canon future.new $future))
  (core func $write (canon future.write $future async (memory (core memory $memory "mem"))))
  (core func $drop (canon future.drop-writable $future))
  (core func $read (canon future.read $future async (memory (core memory $memory "mem"))))
  (core module $m
    (import "" "n" (func $new (result i64)))
    (import "" "w" (func $write (param i32 i32) (result i32)))
    (import "" "d" (func $drop (param i32)))
    (import "" "r" (func $read (param i32 i32) (result i32)))
    (global $writer (mut i32) (i32.const 0))
    (func (export "make") (result i32)
      (local $pair i64)
      (local.set $pair (call $new))
      (global.set $writer (i32.wrap_i64 (i64.shr_u (local.get $pair) (i64.const 32))))
      (i32.wrap_i64 (local.get $pair)))
    (func (export "observe-drop") (result i32)
      (if (i32.ne (call $write (global.get $writer) (i32.const 0)) (i32.const 1))
        (then unreachable))
      (call $drop (global.get $writer))
      (i32.const 42))
    (func (export "read-after-drop") (param $reader i32) (result i32)
      (call $read (local.get $reader) (i32.const 0)))
    (func (export "trap") unreachable))
  (core instance $i (instantiate $m (with "" (instance
    (export "n" (func $new)) (export "w" (func $write))
    (export "d" (func $drop)) (export "r" (func $read))))))
  (func (export "make") (result $future) (canon lift (core func $i "make")))
  (func (export "observe-drop") (result u32) (canon lift (core func $i "observe-drop")))
  (func (export "read-after-drop") (param "reader" $future) (result s32)
    (canon lift (core func $i "read-after-drop")))
  (func (export "trap") (canon lift (core func $i "trap"))))
