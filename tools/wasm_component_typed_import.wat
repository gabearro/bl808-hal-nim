(component
  (component $provider
    (type $other (resource (rep i32)))
    (type $ticket (resource (rep i32)))
    (export $other-public "other" (type $other))
    (export $ticket-public "ticket" (type $ticket))
    (export $ticket-alias "ticket-alias" (type $ticket))
    (canon resource.new $ticket (core func $new))
    (core module $core
      (import "" "new" (func $new (param i32) (result i32)))
      (func (export "make") (param i32) (result i32)
        (call $new (local.get 0)))
      (func (export "get") (param i32) (result i32) (local.get 0))
      (func (export "extra") (result i32) (i32.const 99)))
    (core instance $code (instantiate $core
      (with "" (instance (export "new" (func $new))))))
    (func $extra (result u32) (canon lift (core func $code "extra")))
    (func $make (param "id" u32) (result (own $ticket-public))
      (canon lift (core func $code "make")))
    (func $read (param "token" (borrow $ticket-alias)) (result u32)
      (canon lift (core func $code "get")))
    (func $read-other (param "token" (borrow $other-public)) (result u32)
      (canon lift (core func $code "get")))
    (export "extra" (func $extra))
    (export "get" (func $read))
    (export "make" (func $make)))

  (component $consumer
    (type $contract (component
      (import "unused" (func (result u32)))
      (export "ticket" (type $T (sub resource)))
      (export "ticket-alias" (type $Alias (sub resource)))
      (export "make" (func (param "id" u32) (result (own $T))))
      (export "get" (func (param "token" (borrow $Alias)) (result u32)))))
    (import "factory" (component $factory (type $contract)))
    (core module $dummy (func (export "unused") (result i32) (i32.const 0)))
    (core instance $dummy-code (instantiate $dummy))
    (func $unused (result u32) (canon lift (core func $dummy-code "unused")))
    (instance $a (instantiate $factory (with "unused" (func $unused))))
    (instance $b (instantiate $factory (with "unused" (func $unused))))
    (alias export $a "ticket" (type $TA))
    (alias export $b "ticket" (type $TB))
    (canon resource.drop $TA (core func $drop-a))
    (canon resource.drop $TB (core func $drop-b))
    (canon lower (func $a "make") (core func $make-a))
    (canon lower (func $b "make") (core func $make-b))
    (canon lower (func $a "get") (core func $get-a))
    (canon lower (func $b "get") (core func $get-b))
    (core module $core
      (import "" "new-a" (func $make-a (param i32) (result i32)))
      (import "" "new-b" (func $make-b (param i32) (result i32)))
      (import "" "get-a" (func $get-a (param i32) (result i32)))
      (import "" "get-b" (func $get-b (param i32) (result i32)))
      (import "" "drop-a" (func $drop-a (param i32)))
      (import "" "drop-b" (func $drop-b (param i32)))
      (func (export "run") (result i32) (local $a i32) (local $b i32)
        (local.set $a (call $make-a (i32.const 19)))
        (local.set $b (call $make-b (i32.const 23)))
        (i32.add (call $get-a (local.get $a)) (call $get-b (local.get $b)))
        (call $drop-a (local.get $a))
        (call $drop-b (local.get $b)))
      (func (export "wrong-owner") (result i32)
        (call $get-b (call $make-a (i32.const 19)))))
    (core instance $code (instantiate $core (with "" (instance
      (export "new-a" (func $make-a)) (export "new-b" (func $make-b))
      (export "get-a" (func $get-a)) (export "get-b" (func $get-b))
      (export "drop-a" (func $drop-a)) (export "drop-b" (func $drop-b))))))
    (func (export "run") (result u32) (canon lift (core func $code "run")))
    (func (export "wrong-owner") (result u32) (canon lift (core func $code "wrong-owner"))))
  (instance $api (instantiate $consumer (with "factory" (component $provider))))
  (func (export "run") (alias export $api "run"))
  (func (export "wrong-owner") (alias export $api "wrong-owner")))
