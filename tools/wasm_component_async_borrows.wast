(component definition $test
  (type $ticket (resource (rep i32)))
  (export $named "ticket" (type $ticket))
  (core func $new (canon resource.new $ticket))
  (core func $drop (canon resource.drop $ticket))
  (core module $id
    (func (export "read") (param i32) (result i32) (local.get 0)))
  (core instance $id (instantiate $id))
  (func $read (param "ticket" (borrow $ticket)) (result u32)
    (canon lift (core func $id "read")))
  (func (export "new") (param "rep" u32) (result (own $named)) (canon lift (core func $new)))

  (component $worker
    (import "ticket" (type $ticket (sub resource)))
    (import "read" (func $read (param "ticket" (borrow $ticket)) (result u32)))
    (core func $read (canon lower (func $read)))
    (core func $drop (canon resource.drop $ticket))
    (core func $return (canon task.return (result u32)))
    (core func $cancel (canon task.cancel))
    (core func $get (canon context.get i32 0))
    (core func $set (canon context.set i32 0))
    (core func $arm (canon backpressure.inc))
    (core func $release (canon backpressure.dec))
    (core func $yield (canon thread.yield))
    (core func $done (canon task.return))
    (core func $new-set (canon waitable-set.new))
    (core func $drop-set (canon waitable-set.drop))
    (core func $join (canon waitable.join))
    (core func $drop-task (canon subtask.drop))
    (core module $nested
      (import "" "yield" (func $yield (result i32)))
      (import "" "drop" (func $drop (param i32)))
      (import "" "done" (func $done))
      (func (export "run") (param $handle i32)
        (if (call $yield) (then unreachable))
        (call $drop (local.get $handle))
        (call $done)))
    (core instance $nested (instantiate $nested (with "" (instance
      (export "yield" (func $yield)) (export "drop" (func $drop)) (export "done" (func $done))))))
    (func $nested async (param "ticket" (borrow $ticket))
      (canon lift (core func $nested "run") async))
    (core func $nested (canon lower (func $nested) async))
    (core module $m
      (import "" "read" (func $read (param i32) (result i32)))
      (import "" "drop" (func $drop (param i32)))
      (import "" "return" (func $return (param i32)))
      (import "" "cancel" (func $cancel))
      (import "" "get" (func $get (result i32)))
      (import "" "set" (func $set (param i32)))
      (import "" "nested" (func $nested (param i32) (result i32)))
      (import "" "new-set" (func $new-set (result i32)))
      (import "" "drop-set" (func $drop-set (param i32)))
      (import "" "join" (func $join (param i32 i32)))
      (import "" "drop-task" (func $drop-task (param i32)))
      (import "" "done" (func $done))
      (global $last (mut i32) (i32.const 0))
      (global $set (mut i32) (i32.const 0))
      (func $wait (result i32)
        (i32.or (i32.shl (global.get $set) (i32.const 4)) (i32.const 2)))
      (func $collect-nested (param $event i32) (param $id i32) (param $state i32)
        (if (i32.ne (local.get $event) (i32.const 1)) (then unreachable))
        (if (i32.ne (local.get $state) (i32.const 2)) (then unreachable))
        (call $drop-task (local.get $id))
        (call $drop-set (global.get $set)))
      (func (export "start") (param $handle i32) (param $mode i32) (result i32)
        (local $value i32) (local $status i32)
        (local.set $value (call $read (local.get $handle)))
        (global.set $last (local.get $handle))
        (call $set (i32.or (i32.shl (local.get $handle) (i32.const 16))
          (i32.or (i32.shl (local.get $mode) (i32.const 8)) (local.get $value))))
        (if (i32.eq (local.get $mode) (i32.const 8))
          (then
            (call $drop (local.get $handle))
            (call $return (local.get $value))
            (return (i32.const 0))))
        (if (i32.ge_u (local.get $mode) (i32.const 10))
          (then
            (local.set $status (call $nested (local.get $handle)))
            (if (i32.ne (i32.and (local.get $status) (i32.const 15)) (i32.const 1))
              (then unreachable))
            (if (i32.eq (local.get $mode) (i32.const 11)) (then (call $drop (local.get $handle))))
            (global.set $set (call $new-set))
            (call $join (i32.shr_u (local.get $status) (i32.const 4)) (global.get $set))
            (return (call $wait))))
        (i32.const 1))
      (func (export "next") (param $event i32) (param $id i32) (param $state i32) (result i32)
        (local $mode i32) (local $handle i32)
        (local.set $mode (i32.and (i32.shr_u (call $get) (i32.const 8)) (i32.const 255)))
        (local.set $handle (i32.shr_u (call $get) (i32.const 16)))
        (if (i32.eq (local.get $mode) (i32.const 10))
          (then (call $collect-nested (local.get $event) (local.get $id) (local.get $state))))
        (if (i32.eq (local.get $event) (i32.const 6))
          (then
            (if (i32.eq (local.get $mode) (i32.const 4)) (then (call $drop (local.get $handle))))
            (call $cancel)
            (return (i32.const 0))))
        (if (i32.and (i32.ne (local.get $mode) (i32.const 2))
            (i32.ne (local.get $mode) (i32.const 6)))
          (then (call $drop (local.get $handle))))
        (call $return (i32.and (call $get) (i32.const 255)))
        (i32.const 0))
      (func (export "drain") (result i32) (call $wait))
      (func (export "drain-next") (param i32 i32 i32) (result i32)
        (call $collect-nested (local.get 0) (local.get 1) (local.get 2))
        (call $done)
        (i32.const 0))
      (func (export "drop-other") (call $drop (global.get $last))))
    (core instance $i (instantiate $m (with "" (instance
      (export "read" (func $read)) (export "drop" (func $drop))
      (export "return" (func $return)) (export "cancel" (func $cancel))
      (export "get" (func $get)) (export "set" (func $set))
      (export "nested" (func $nested)) (export "done" (func $done))
      (export "new-set" (func $new-set)) (export "drop-set" (func $drop-set))
      (export "join" (func $join)) (export "drop-task" (func $drop-task))))))
    (func (export "work") async (param "ticket" (borrow $ticket)) (param "mode" u32) (result u32)
      (canon lift (core func $i "start") async (callback (core func $i "next"))))
    (func (export "drain") async
      (canon lift (core func $i "drain") async (callback (core func $i "drain-next"))))
    (func (export "drop-other") (canon lift (core func $i "drop-other")))
    (func (export "arm") (canon lift (core func $arm)))
    (func (export "release") (canon lift (core func $release))))

  (instance $worker (instantiate $worker (with "ticket" (type $named)) (with "read" (func $read))))
  (export "borrow" (func $worker "work"))
  (export "drain" (func $worker "drain"))
  (export "drop-other" (func $worker "drop-other"))
  (core module $memory (memory (export "m") 1))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "m" (core memory $mem))
  (core func $work (canon lower (func $worker "work") async (memory $mem)))
  (core func $sync (canon lower (func $worker "work")))
  (core func $other (canon lower (func $worker "drop-other")))
  (core func $arm (canon lower (func $worker "arm")))
  (core func $release (canon lower (func $worker "release")))
  (core func $return (canon task.return (result u32)))
  (core func $cancel (canon subtask.cancel))
  (core func $new-set (canon waitable-set.new))
  (core func $drop-set (canon waitable-set.drop))
  (core func $join (canon waitable.join))
  (core func $drop-task (canon subtask.drop))
  (core module $m
    (import "" "mem" (memory 1))
    (import "" "new" (func $new (param i32) (result i32)))
    (import "" "drop" (func $drop (param i32)))
    (import "" "work" (func $work (param i32 i32 i32) (result i32)))
    (import "" "sync" (func $sync (param i32 i32) (result i32)))
    (import "" "other" (func $other))
    (import "" "arm" (func $arm))
    (import "" "release" (func $release))
    (import "" "return" (func $return (param i32)))
    (import "" "cancel" (func $cancel (param i32) (result i32)))
    (import "" "new-set" (func $new-set (result i32)))
    (import "" "drop-set" (func $drop-set (param i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "drop-task" (func $drop-task (param i32)))
    (global $owner (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))
    (global $events (mut i32) (i32.const 0))
    (func $check (param i32 i32)
      (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func $finish (result i32)
      (call $drop (global.get $owner))
      (call $return (i32.const 42))
      (i32.const 0))
    (func $wait (result i32)
      (i32.or (i32.shl (global.get $set) (i32.const 4)) (i32.const 2)))
    (func (export "start") (param $mode i32) (result i32)
      (local $status i32) (local $task i32)
      (global.set $owner (call $new (i32.const 42)))
      (i32.store (i32.const 0) (i32.const -1))
      (i32.store (i32.const 4) (i32.const -1))
      (if (i32.eq (local.get $mode) (i32.const 5))
        (then
          (call $arm)
          (local.set $status (call $work (i32.const 0) (i32.const 5) (i32.const 0)))
          (call $check (i32.and (local.get $status) (i32.const 15)) (i32.const 0))
          (local.set $task (i32.shr_u (local.get $status) (i32.const 4)))
          (call $check (call $cancel (local.get $task)) (i32.const 3))
          (call $drop-task (local.get $task))
          (call $release)
          (return (call $finish))))
      (if (i32.eq (local.get $mode) (i32.const 9))
        (then
          (call $check (call $sync (global.get $owner) (i32.const 0)) (i32.const 42))
          (return (call $finish))))
      (local.set $status (call $work (global.get $owner) (local.get $mode) (i32.const 0)))
      (if (i32.eq (local.get $mode) (i32.const 8))
        (then
          (call $check (local.get $status) (i32.const 2))
          (call $check (i32.load (i32.const 0)) (i32.const 42))
          (return (call $finish))))
      (call $check (i32.and (local.get $status) (i32.const 15)) (i32.const 1))
      (local.set $task (i32.shr_u (local.get $status) (i32.const 4)))
      (if (i32.eq (local.get $mode) (i32.const 1)) (then (return (i32.const 1))))
      (if (i32.or (i32.eq (local.get $mode) (i32.const 3)) (i32.eq (local.get $mode) (i32.const 4)))
        (then
          (call $check (call $cancel (local.get $task)) (i32.const 4))
          (call $drop-task (local.get $task))
          (return (call $finish))))
      (if (i32.eq (local.get $mode) (i32.const 6)) (then (call $other)))
      (global.set $set (call $new-set))
      (global.set $events (i32.const 1))
      (call $join (local.get $task) (global.get $set))
      (if (i32.eq (local.get $mode) (i32.const 7))
        (then
          (local.set $status (call $work (global.get $owner) (i32.const 0) (i32.const 4)))
          (call $check (i32.and (local.get $status) (i32.const 15)) (i32.const 1))
          (call $join (i32.shr_u (local.get $status) (i32.const 4)) (global.get $set))
          (global.set $events (i32.const 2))))
      (call $wait))
    (func (export "next") (param $code i32) (param $task i32) (param $state i32) (result i32)
      (call $check (i32.load (i32.const 0)) (i32.const 42))
      (if (i32.eqz (local.get $code)) (then (return (call $finish))))
      (call $check (local.get $code) (i32.const 1))
      (call $check (local.get $state) (i32.const 2))
      (call $drop-task (local.get $task))
      (if (i32.eq (global.get $events) (i32.const 2))
        (then (global.set $events (i32.const 1)) (return (call $wait))))
      (call $drop-set (global.get $set))
      (call $finish)))
  (core instance $i (instantiate $m (with "" (instance
    (export "mem" (memory $mem)) (export "new" (func $new)) (export "drop" (func $drop))
    (export "work" (func $work)) (export "sync" (func $sync)) (export "other" (func $other))
    (export "arm" (func $arm)) (export "release" (func $release))
    (export "return" (func $return)) (export "cancel" (func $cancel))
    (export "new-set" (func $new-set)) (export "drop-set" (func $drop-set))
    (export "join" (func $join)) (export "drop-task" (func $drop-task))))))
  (func (export "run") async (param "mode" u32) (result u32)
    (canon lift (core func $i "start") async (callback (core func $i "next")))))

(component instance $ok $test)
(assert_return (invoke $ok "run" (u32.const 0)) (u32.const 42))
(assert_return (invoke $ok "run" (u32.const 4)) (u32.const 42))
(assert_return (invoke $ok "run" (u32.const 5)) (u32.const 42))
(assert_return (invoke $ok "run" (u32.const 6)) (u32.const 42))
(assert_return (invoke $ok "run" (u32.const 7)) (u32.const 42))
(assert_return (invoke $ok "run" (u32.const 8)) (u32.const 42))
(assert_return (invoke $ok "run" (u32.const 9)) (u32.const 42))
(assert_return (invoke $ok "run" (u32.const 10)) (u32.const 42))
(component instance $pending $test)
(assert_trap (invoke $pending "run" (u32.const 1)) "crBorrowActive")
(component instance $return $test)
(assert_trap (invoke $return "run" (u32.const 2)) "borrow handles still remain at the end of the call")
(component instance $cancel $test)
(assert_trap (invoke $cancel "run" (u32.const 3)) "borrow handles still remain at the end of the call")
(component instance $nested $test)
(assert_trap (invoke $nested "run" (u32.const 11)) "crBorrowActive")
