(component
  (component $callee
    (core func $return (canon task.return (result u32)))
    (core func $arm (canon backpressure.inc))
    (core func $release (canon backpressure.dec))
    (core module $core
      (import "" "return" (func $return (param i32)))
      (global $arg (mut i32) (i32.const 0))
      (global $finished (mut i32) (i32.const 0))
      (func (export "start") (param i32) (result i32)
        (if (i32.eq (local.get 0) (i32.const 8))
          (then (call $return (i32.const 9)) (return (i32.const 0))))
        (global.set $arg (local.get 0))
        (i32.const 1))
      (func (export "next") (param i32 i32 i32) (result i32)
        (if (i32.eqz (global.get $arg))
          (then (global.set $finished (i32.const 1)) (return (i32.const 0))))
        (call $return (i32.add (global.get $arg) (i32.const 1)))
        (global.set $arg (i32.const 0))
        (i32.const 1))
      (func (export "finished") (result i32) (global.get $finished)))
    (core instance $core (instantiate $core (with "" (instance (export "return" (func $return))))))
    (func (export "arm") (canon lift (core func $arm)))
    (func (export "release") (canon lift (core func $release)))
    (func (export "finished") (result u32) (canon lift (core func $core "finished")))
    (func (export "compute") async (param "x" u32) (result u32)
      (canon lift (core func $core "start") async (callback (core func $core "next")))))

  (instance $callee (instantiate $callee))
  (core module $memory (memory (export "buf") 1))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "buf" (core memory $mem))
  (core func $arm (canon lower (func $callee "arm")))
  (core func $release (canon lower (func $callee "release")))
  (core func $compute (canon lower (func $callee "compute") async (memory $mem)))
  (core func $new (canon waitable-set.new))
  (core func $poll (canon waitable-set.poll (memory $mem)))
  (core func $drop-set (canon waitable-set.drop))
  (core func $join (canon waitable.join))
  (core func $drop-task (canon subtask.drop))
  (core func $return (canon task.return (result u32)))

  (core module $caller
    (import "" "mem" (memory 1))
    (import "" "arm" (func $arm))
    (import "" "release" (func $release))
    (import "" "compute" (func $compute (param i32 i32) (result i32)))
    (import "" "new" (func $new (result i32)))
    (import "" "poll" (func $poll (param i32 i32) (result i32)))
    (import "" "drop-set" (func $drop-set (param i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "drop-task" (func $drop-task (param i32)))
    (import "" "return" (func $return (param i32)))
    (global $ws (mut i32) (i32.const 0))
    (global $task (mut i32) (i32.const 0))
    (func $wait (result i32) (i32.or (i32.const 2) (i32.shl (global.get $ws) (i32.const 4))))
    (func (export "start") (result i32)
      (local $status i32)
      (global.set $ws (call $new))
      (call $arm)
      (local.set $status (call $compute (i32.const 41) (i32.const 8)))
      (if (i32.ne (local.get $status) (i32.const 0x20)) (then unreachable))
      (global.set $task (i32.shr_u (local.get $status) (i32.const 4)))
      (call $join (global.get $task) (global.get $ws))
      (i32.store (i32.const 16) (i32.const -1))
      (i32.store (i32.const 20) (i32.const -1))
      (if (i32.or (call $poll (global.get $ws) (i32.const 16))
          (i32.or (i32.load (i32.const 16)) (i32.load (i32.const 20)))) (then unreachable))
      (call $release)
      (call $wait))
    (func (export "next") (param $code i32) (param $id i32) (param $state i32) (result i32)
      (if (i32.ne (local.get $code) (i32.const 1)) (then unreachable))
      (if (i32.ne (local.get $id) (global.get $task)) (then unreachable))
      (if (i32.eq (local.get $state) (i32.const 1))
        (then
          (if (i32.load (i32.const 8)) (then unreachable))
          (return (call $wait))))
      (if (i32.ne (local.get $state) (i32.const 2)) (then unreachable))
      (if (i32.ne (i32.load (i32.const 8)) (i32.const 42)) (then unreachable))
      (call $drop-task (global.get $task))
      (call $drop-set (global.get $ws))
      (if (i32.ne (call $compute (i32.const 8) (i32.const 8)) (i32.const 2)) (then unreachable))
      (if (i32.ne (i32.load (i32.const 8)) (i32.const 9)) (then unreachable))
      (if (i32.ne (call $new) (global.get $ws)) (then unreachable))
      (call $drop-set (global.get $ws))
      (call $return (i32.const 42))
      (i32.const 0)))
  (core instance $caller (instantiate $caller (with "" (instance
    (export "mem" (memory $mem)) (export "arm" (func $arm)) (export "release" (func $release))
    (export "compute" (func $compute)) (export "new" (func $new)) (export "poll" (func $poll))
    (export "drop-set" (func $drop-set)) (export "join" (func $join))
    (export "drop-task" (func $drop-task)) (export "return" (func $return))))))
  (func (export "run") async (result u32)
    (canon lift (core func $caller "start") async (callback (core func $caller "next"))))
  (export "finished" (func $callee "finished")))
