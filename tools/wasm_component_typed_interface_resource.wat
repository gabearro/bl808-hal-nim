(component
  (component $provider
    (import "source" (instance $source (export "input" (type (sub resource)))))
    (alias export $source "input" (type $Input))
    (type $wrong (resource (rep i32)))
    (type $bundle (list (own $Input)))
    (core module $code
      (func (export "extra") (result i32) (i32.const 19))
      (func (export "forward") (param i32) (result i32) (local.get 0)))
    (core instance $core (instantiate $code))
    (func $extra (result u32) (canon lift (core func $core "extra")))
    (func $forward (param "token" (own $Input)) (result (own $Input))
      (canon lift (core func $core "forward")))
    (instance $ignored (export "extra" (func $extra)))
    (instance $surface
      (export "ticket" (type $Input))
      (export "input" (type $Input))
      (export "bundle" (type $bundle))
      (export "extra" (func $extra))
      (export "forward" (func $forward)))
    (export "extra" (instance $ignored))
    (export "tickets" (instance $surface)))
  (component $consumer
    (type $contract (component
      (import "source" (instance $source (export "input" (type (sub resource)))))
      (alias export $source "input" (type $Input))
      (export "tickets" (instance
        (export "ticket" (type $Ticket (eq $Input)))
        (type $bundle (list (own $Ticket)))
        (export "bundle" (type (eq $bundle)))
        (export "forward" (func (param "token" (own $Ticket)) (result (own $Ticket))))))))
    (import "factory" (component $factory (type $contract)))
    (type $r (resource (rep i32)))
    (instance $source (export "input" (type $r)))
    (instance $api (instantiate $factory (with "source" (instance $source))))
    (alias export $api "tickets" (instance $tickets))
    (alias export $tickets "ticket" (type $Ticket))
    (core func $new (canon resource.new $r))
    (core func $rep (canon resource.rep $r))
    (core func $drop (canon resource.drop $Ticket))
    (core func $forward (canon lower (func $tickets "forward")))
    (core module $code
      (import "" "new" (func $new (param i32) (result i32)))
      (import "" "rep" (func $rep (param i32) (result i32)))
      (import "" "forward" (func $forward (param i32) (result i32)))
      (import "" "drop" (func $drop (param i32)))
      (func (export "run") (result i32) (local $token i32)
        (local.set $token (call $forward (call $new (i32.const 42))))
        (call $rep (local.get $token))
        (call $drop (local.get $token))))
    (core instance $core (instantiate $code (with "" (instance
      (export "new" (func $new)) (export "rep" (func $rep))
      (export "forward" (func $forward)) (export "drop" (func $drop))))))
    (func (export "run") (result u32) (canon lift (core func $core "run"))))
  (instance $api (instantiate $consumer (with "factory" (component $provider))))
  (func (export "run") (alias export $api "run")))
