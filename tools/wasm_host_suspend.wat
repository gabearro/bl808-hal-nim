(module
  (type $call (func (param i32) (result i32)))
  (import "host" "wait" (func $wait (type $call)))
  (export "host" (func $wait))
  (table 1 funcref)
  (elem (i32.const 0) $wait)
  (func (export "direct") (param i32) (result i32)
    (i32.add (i32.const 2) (call $wait (local.get 0))))
  (func (export "indirect") (param i32) (result i32)
    (i32.add (i32.const 2) (call_indirect (type $call) (local.get 0) (i32.const 0))))
  (func $tail (export "tail") (param i32) (result i32)
    (return_call $wait (i32.add (local.get 0) (i32.const 2))))
  (func (export "indirect-tail") (param i32) (result i32)
    (return_call_indirect (type $call) (i32.add (local.get 0) (i32.const 2)) (i32.const 0)))
  (func (export "nested-tail") (param i32) (result i32)
    (call $tail (local.get 0)))
  (func $recurse (param $n i32) (param $val i32) (result i32)
    (if (result i32) (local.get $n)
      (then (call $recurse (i32.sub (local.get $n) (i32.const 1)) (local.get $val)))
      (else (call $tail (local.get $val)))))
  (func (export "deep") (param i32) (result i32)
    (call $recurse (i32.const 8) (local.get 0))))
