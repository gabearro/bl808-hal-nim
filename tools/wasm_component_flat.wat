(module
  (import "cm32p2" "verify" (func $verify (param i32 f64 i32 i64 i32 i32 i32 i32 i32) (result i32)))
  (memory (export "cm32p2_memory") 1)
  (data (i32.const 32) "Ox64")
  (data (i32.const 40) "\04\03\02\01\08\07\06\05")
  (func (export "cm32p2_realloc") (param i32 i32 i32 i32) (result i32)
    i32.const 64)
  (export "cm32p2||signature" (func $verify))
  (func (export "cm32p2||run") (result i32)
    (call $verify
      (i32.const 0xffffff2a) (f64.const 2.5)
      (i32.const 0) (i64.const 0xfeedbeef3f800000)
      (i32.const 1) (i32.const 32) (i32.const 4)
      (i32.const 40) (i32.const 2))
    (call $verify
      (i32.const 42) (f64.const 2.5)
      (i32.const 1) (i64.const 0xfedcba9876543210)
      (i32.const 0) (i32.const -1) (i32.const -1)
      (i32.const 40) (i32.const 2))
    i32.add)
  (func (export "cm32p2||bad-tag") (result i32)
    (call $verify
      (i32.const 42) (f64.const 2.5)
      (i32.const 2) (i64.const 0)
      (i32.const 0) (i32.const 0) (i32.const 0)
      (i32.const 40) (i32.const 2))))
