(module
  (memory $first 1 1)
  (memory $second 1 2)
  (data (memory $second) (i32.const 512) "\77")
  (data $bytes "\5a\5b")

  (func (export "size-first") (result i32) (memory.size $first))
  (func (export "size-second") (result i32) (memory.size $second))
  (func (export "grow-second") (result i32) (memory.grow $second (i32.const 1)))
  (func (export "indexed-store") (param i32)
    (i32.store $second (i32.const 32) (local.get 0)))
  (func (export "indexed-load") (param i32) (result i32)
    (i32.load $second (local.get 0)))
  (func (export "boundary") (result i32)
    (i32.store $second (i32.const 511) (i32.const 0x12345678))
    (i32.load $second (i32.const 511)))
  (func (export "copy") (result i32)
    (memory.fill $first (i32.const 507) (i32.const 68) (i32.const 12))
    (memory.init $second $bytes (i32.const 511) (i32.const 0) (i32.const 2))
    (memory.copy $first $second (i32.const 511) (i32.const 511) (i32.const 2))
    (i32.load $first (i32.const 510)))
  (func (export "dropped-zero-length")
    (data.drop $bytes)
    (memory.init $second $bytes (i32.const 0) (i32.const 1) (i32.const 0))))
