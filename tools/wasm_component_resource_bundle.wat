(module
  (import "cm32p2|_ex_bundles" "ticket_new" (func $new (param i32) (result i32)))
  (memory (export "cm32p2_memory") 1)
  (global $dropped (mut i32) (i32.const 0))
  (global $next (mut i32) (i32.const 16))
  (func (export "cm32p2_realloc") (param i32 i32 i32 i32) (result i32)
    (local $pointer i32)
    (local.set $pointer (global.get $next))
    (global.set $next (i32.add (local.get $pointer) (local.get 3)))
    (local.get $pointer))
  (func (export "cm32p2|bundles|[constructor]ticket") (param i32) (result i32)
    (call $new (local.get 0)))
  (func (export "cm32p2|bundles|[method]ticket.get") (param i32) (result i32)
    (local.get 0))
  (func (export "cm32p2|bundles|ticket_dtor") (param i32)
    (global.set $dropped (local.get 0)))
  (func (export "cm32p2|bundles|last-dropped") (result i32)
    (global.get $dropped))
  (func (export "cm32p2|bundles|exchange") (param $tag i32) (param $tickets i32)
    (param $count i32) (result i32)
    (i32.store (i32.const 0) (local.get $tag))
    (i32.store (i32.const 4) (local.get $tickets))
    (i32.store (i32.const 8) (local.get $count))
    (i32.const 0))
  (func (export "cm32p2|bundles|peek") (param $tag i32) (param $borrow i32) (result i32)
    (i32.mul (local.get $tag) (local.get $borrow))))
