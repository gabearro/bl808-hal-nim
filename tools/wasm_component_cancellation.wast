;; Callback cancellation cases isolated from stackful, future, and stream APIs.
(component definition $test
  (component $worker
    (core func $cancel (canon task.cancel))
    (core func $return (canon task.return (result u32)))
    (core func $arm (canon backpressure.inc))
    (core func $release (canon backpressure.dec))
    (core func $get (canon context.get i32 0))
    (core func $set (canon context.set i32 0))
    (core func $new (canon waitable-set.new))
    (core func $drop (canon waitable-set.drop))
    (core module $m
      (import "" "cancel" (func $cancel))
      (import "" "return" (func $return (param i32)))
      (import "" "get" (func $get (result i32)))
      (import "" "set" (func $set (param i32)))
      (import "" "new" (func $new (result i32)))
      (import "" "drop" (func $drop (param i32)))
      (func $check (param i32 i32)
        (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
      (func (export "entry") (param $mode i32) (result i32)
        (local $set i32)
        (if (i32.eqz (local.get $mode)) (then unreachable))
        (if (i32.eq (local.get $mode) (i32.const 6)) (then (call $cancel)))
        (if (i32.eq (local.get $mode) (i32.const 1))
          (then
            (local.set $set (call $new))
            (call $set (i32.or (i32.shl (local.get $set) (i32.const 8)) (i32.const 1)))
            (return (i32.or (i32.shl (local.get $set) (i32.const 4)) (i32.const 2)))))
        (call $set (local.get $mode))
        (i32.const 1))
      (func (export "callback") (param $event i32) (param $id i32) (param $state i32) (result i32)
        (local $mode i32)
        (local.set $mode (i32.and (call $get) (i32.const 255)))
        (call $check (local.get $id) (i32.const 0))
        (call $check (local.get $state) (i32.const 0))
        (if (i32.eq (local.get $mode) (i32.const 9))
          (then
            (call $check (local.get $event) (i32.const 0))
            (call $cancel)
            (return (i32.const 0))))
        (if (i32.eq (local.get $mode) (i32.const 4))
          (then
            (call $check (local.get $event) (i32.const 0))
            (call $return (i32.const 42))
            (return (i32.const 0))))
        (call $check (local.get $event) (i32.const 6))
        (if (i32.eq (local.get $mode) (i32.const 1))
          (then (call $drop (i32.shr_u (call $get) (i32.const 8)))))
        (if (i32.eq (local.get $mode) (i32.const 2))
          (then (call $set (i32.const 9)) (return (i32.const 1))))
        (if (i32.eq (local.get $mode) (i32.const 3))
          (then (call $return (i32.const 42)) (return (i32.const 0))))
        (call $cancel)
        (i32.const 0)))
    (core instance $i (instantiate $m (with "" (instance
      (export "cancel" (func $cancel)) (export "return" (func $return))
      (export "get" (func $get)) (export "set" (func $set))
      (export "new" (func $new)) (export "drop" (func $drop))))))
    (func (export "work") async (param "mode" u32) (result u32)
      (canon lift (core func $i "entry") async (callback (core func $i "callback"))))
    (func (export "arm") (canon lift (core func $arm)))
    (func (export "release") (canon lift (core func $release)))
    (func (export "cancel-outside") (canon lift (core func $cancel))))

  (instance $worker (instantiate $worker))
  (core module $memory (memory (export "buffer") 1))
  (core instance $memory (instantiate $memory))
  (alias core export $memory "buffer" (core memory $mem))
  (core func $work (canon lower (func $worker "work") async (memory $mem)))
  (core func $arm (canon lower (func $worker "arm")))
  (core func $release (canon lower (func $worker "release")))
  (core func $cancel-now (canon subtask.cancel))
  (core func $cancel-async (canon subtask.cancel async))
  (core func $new (canon waitable-set.new))
  (core func $drop-set (canon waitable-set.drop))
  (core func $join (canon waitable.join))
  (core func $drop-task (canon subtask.drop))
  (core func $return (canon task.return))
  (core module $m
    (import "" "mem" (memory 1))
    (import "" "work" (func $work (param i32 i32) (result i32)))
    (import "" "arm" (func $arm))
    (import "" "release" (func $release))
    (import "" "cancel-now" (func $cancel-now (param i32) (result i32)))
    (import "" "cancel-async" (func $cancel-async (param i32) (result i32)))
    (import "" "new" (func $new (result i32)))
    (import "" "drop-set" (func $drop-set (param i32)))
    (import "" "join" (func $join (param i32 i32)))
    (import "" "drop-task" (func $drop-task (param i32)))
    (import "" "return" (func $return))
    (global $task (mut i32) (i32.const 0))
    (global $set (mut i32) (i32.const 0))
    (func $check (param i32 i32)
      (if (i32.ne (local.get 0) (local.get 1)) (then unreachable)))
    (func (export "entry") (param $mode i32) (result i32)
      (local $packed i32) (local $count i32) (local $other i32)
      (i32.store (i32.const 0) (i32.const -1))
      (if (i32.eqz (local.get $mode))
        (then
          (call $arm)
          (loop $repeat
            ;; More than the queue's capacity in a single guest turn.
            (local.set $packed (call $work (i32.const 0) (i32.const 0)))
            (call $check (i32.and (local.get $packed) (i32.const 15)) (i32.const 0))
            (call $check (call $cancel-now (i32.shr_u (local.get $packed) (i32.const 4))) (i32.const 3))
            (call $drop-task (i32.shr_u (local.get $packed) (i32.const 4)))
            (local.set $count (i32.add (local.get $count) (i32.const 1)))
            (br_if $repeat (i32.lt_u (local.get $count) (i32.const 40))))
          (call $release)
          (call $check (i32.load (i32.const 0)) (i32.const -1))
          (call $return)
          (return (i32.const 0))))
      (if (i32.eq (local.get $mode) (i32.const 3))
        (then
          ;; This earlier runnable subtask must remain suspended while
          ;; subtask.cancel resumes the targeted one.
          (i32.store (i32.const 4) (i32.const -1))
          (local.set $other (i32.shr_u (call $work (i32.const 3) (i32.const 4)) (i32.const 4)))))
      (local.set $packed (call $work
        (select (i32.const 2) (local.get $mode) (i32.eq (local.get $mode) (i32.const 7)))
        (i32.const 0)))
      (call $check (i32.and (local.get $packed) (i32.const 15)) (i32.const 1))
      (global.set $task (i32.shr_u (local.get $packed) (i32.const 4)))
      (if (i32.eq (local.get $mode) (i32.const 4)) (then (return (i32.const 1))))
      (if (i32.eq (local.get $mode) (i32.const 5))
        (then
          (call $join (global.get $task) (call $new))
          (drop (call $cancel-async (global.get $task)))
          unreachable))
      (if (i32.or (i32.eq (local.get $mode) (i32.const 2)) (i32.eq (local.get $mode) (i32.const 7)))
        (then
          (call $check (call $cancel-async (global.get $task)) (i32.const -1))
          (if (i32.eq (local.get $mode) (i32.const 7))
            (then (drop (call $cancel-async (global.get $task))) unreachable))
          (global.set $set (call $new))
          (call $join (global.get $task) (global.get $set))
          (return (i32.or (i32.shl (global.get $set) (i32.const 4)) (i32.const 2)))))
      (if (i32.eq (local.get $mode) (i32.const 3))
        (then
          (call $check (call $cancel-async (global.get $task)) (i32.const 2))
          (call $check (i32.load (i32.const 0)) (i32.const 42))
          (call $check (i32.load (i32.const 4)) (i32.const -1))
          (call $check (call $cancel-async (local.get $other)) (i32.const 2))
          (call $check (i32.load (i32.const 4)) (i32.const 42))
          (call $drop-task (local.get $other)))
        (else
          (call $check (call $cancel-now (global.get $task)) (i32.const 4))
          (call $check (i32.load (i32.const 0)) (i32.const -1))))
      (call $drop-task (global.get $task))
      (call $return)
      (i32.const 0))
    (func (export "callback") (param $event i32) (param $id i32) (param $state i32) (result i32)
      (if (local.get $event)
        (then
          (call $check (local.get $event) (i32.const 1))
          (call $check (local.get $id) (global.get $task))
          (call $check (local.get $state) (i32.const 4))
          (call $check (i32.load (i32.const 0)) (i32.const -1))
          (call $drop-task (global.get $task))
          (call $drop-set (global.get $set)))
        (else
          (call $check (call $cancel-async (global.get $task)) (i32.const 2))
          (call $check (i32.load (i32.const 0)) (i32.const 42))
          (call $drop-task (global.get $task))))
      (call $return)
      (i32.const 0)))
  (core instance $i (instantiate $m (with "" (instance
    (export "mem" (memory $mem)) (export "work" (func $work))
    (export "arm" (func $arm)) (export "release" (func $release))
    (export "cancel-now" (func $cancel-now)) (export "cancel-async" (func $cancel-async))
    (export "new" (func $new)) (export "drop-set" (func $drop-set))
    (export "join" (func $join)) (export "drop-task" (func $drop-task))
    (export "return" (func $return))))))
  (func (export "run") async (param "mode" u32)
    (canon lift (core func $i "entry") async (callback (core func $i "callback"))))
  (export "cancel-outside" (func $worker "cancel-outside")))

(component instance $i $test)
(assert_return (invoke $i "run" (u32.const 0)))
(assert_return (invoke $i "run" (u32.const 1)))
(assert_return (invoke $i "run" (u32.const 2)))
(assert_return (invoke $i "run" (u32.const 3)))
(assert_return (invoke $i "run" (u32.const 4)))

(component instance $joined $test)
(assert_trap (invoke $joined "run" (u32.const 5)) "canonical subtask cannot be cancelled")
(component instance $unsolicited $test)
(assert_trap (invoke $unsolicited "run" (u32.const 6)) "canonical task.cancel requires a delivered cancellation")
(component instance $duplicate $test)
(assert_trap (invoke $duplicate "run" (u32.const 7)) "canonical subtask cannot be cancelled")
(component instance $outside $test)
(assert_trap (invoke $outside "cancel-outside") "canonical task.cancel requires a delivered cancellation")
